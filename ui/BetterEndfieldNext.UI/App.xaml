                            <SolidColorBrush Color="#FFFFFFFF" x:Key="TextOnAccentFillColorPrimaryBrush"/>
                            <SolidColorBrush Color="#FFFDF7F5" x:Key="TextOnAccentFillColorSecondaryBrush"/>

                            <LinearGradientBrush EndPoint="1,1" StartPoint="0,0" x:Key="AccentButtonBackground">
                                <GradientStop Color="#FFE07A64" Offset="0.0"/>
                                <GradientStop Color="#FFC45A47" Offset="1.0"/>
