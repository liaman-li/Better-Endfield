                                                            OnContent="隐藏 UID"
                                                            Style="{StaticResource CompactToggleSwitchStyle}"
                                                            Toggled="UiEnhancementToggle_Toggled" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Right Column: HUD Visibility -->
                                        <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                                            <Border Style="{StaticResource SectionStyle}">
                                                <StackPanel Spacing="14">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock x:Name="HideHudSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="HUD 显示" />
                                                        <TextBlock
                                                            x:Name="HideHudSectionHint"
                                                            Style="{StaticResource FieldHintStyle}"
                                                            Text="通过热键隐藏或恢复游戏内 MainHudRoot 下的全部 HUD 画布，不影响菜单和设置界面。"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />
                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock
                                                                FontSize="14"
                                                                FontWeight="Bold"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                Text="{Binding Header, ElementName=HideHudToggle}" />
                                                            <TextBlock
                                                                Style="{StaticResource FieldHintStyle}"
                                                                Text="{Binding OnContent, ElementName=HideHudToggle}" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            x:Name="HideHudToggle"
                                                            Grid.Column="1"
                                                            Header="启用隐藏全部 HUD 热键"
                                                            OffContent="关闭"
                                                            OnContent="允许热键切换"
                                                            Style="{StaticResource CompactToggleSwitchStyle}"
                                                            Toggled="UiEnhancementToggle_Toggled" />
                                                    </Grid>
                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />
                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                            Text="{Binding Header, ElementName=HideHudHotkeyBox}" />
                                                        <TextBox
                                                            x:Name="HideHudHotkeyBox"
                                                            Grid.Column="1"
                                                            Width="140"
                                                            Header="HUD 显示切换热键"
                                                            LostFocus="HideHudHotkeyBox_LostFocus"
                                                            MaxLength="8"
                                                            PlaceholderText="例如 0、F10"
                                                            Text="0">
                                                            <TextBox.HeaderTemplate>
                                                                <DataTemplate>
                                                                    <Grid Width="0" Height="0" Visibility="Collapsed" />
                                                                </DataTemplate>
                                                            </TextBox.HeaderTemplate>
                                                        </TextBox>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </controls:PageContentPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid
                            x:Name="ActionsPageScrollViewer"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Fixed Page Header -->
                            <StackPanel Grid.Row="0" Padding="28,22,28,12" Spacing="4">
                                <TextBlock x:Name="ActionsPageTitle" Style="{StaticResource PageTitleStyle}" Text="冲刺持续" />
                                <TextBlock
                                    x:Name="ActionsPageDescription"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="分角色开启特殊冲刺动作的持续播放。设置保存后，下一次特殊冲刺生效。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Row 1: Scrollable Body -->
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <controls:PageContentPanel Padding="28,4,28,28">
                                    <StackPanel Spacing="16">
                                        <!-- Keep InfoBar instance for C# localization binding while rendering with HintBannerBorderStyle -->
                                        <InfoBar
                                            x:Name="ActionsExperimentalInfo"
                                            IsOpen="True"
                                            IsClosable="False"
                                            Severity="Informational"
                                            Title="实验功能"
                                            Message="保留游戏本次选中的左或右特殊冲刺动作，在持续冲刺时循环播放，延后自然结束；停止或被打断时结束。"
                                            Visibility="Collapsed" />

                                        <Border Style="{StaticResource HintBannerBorderStyle}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    VerticalAlignment="Top"
                                                    Padding="10,3"
                                                    CornerRadius="8"
                                                    Background="{ThemeResource AccentBadgeBackgroundBrush}">
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="Bold"
                                                        Foreground="{ThemeResource AccentBadgeForegroundBrush}"
                                                        Text="{Binding Title, ElementName=ActionsExperimentalInfo}" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Message, ElementName=ActionsExperimentalInfo}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>

                                        <!-- 3 Equal-Width L3 Character Cards -->
                                        <Grid ColumnSpacing="18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Card 1: Aglina (洁尔佩塔) -->
                                            <Border Grid.Column="0" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                <StackPanel Spacing="14">
                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource SectionTitleStyle}"
                                                            Text="{Binding Header, ElementName=ContinuousSpecialDashAglinaToggle}" />
                                                        <ToggleSwitch
                                                            x:Name="ContinuousSpecialDashAglinaToggle"
                                                            Grid.Column="1"
                                                            Header="洁尔佩塔"
                                                            OffContent="关闭"
                                                            OnContent="开启"
                                                            Style="{StaticResource CompactToggleSwitchStyle}"
                                                            Toggled="ActionsToggle_Toggled" />
                                                    </Grid>
                                                    <Border Style="{StaticResource SettingsRowStyle}">
                                                        <TextBlock
                                                            Style="{StaticResource FieldHintStyle}"
                                                            Text="{Binding Message, ElementName=ActionsExperimentalInfo}"
                                                            TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 2: Liino (梨诺) -->
                                            <Border Grid.Column="1" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                <StackPanel Spacing="14">
                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource SectionTitleStyle}"
                                                            Text="{Binding Header, ElementName=ContinuousSpecialDashLiinoToggle}" />
                                                        <ToggleSwitch
                                                            x:Name="ContinuousSpecialDashLiinoToggle"
                                                            Grid.Column="1"
                                                            Header="梨诺"
                                                            OffContent="关闭"
                                                            OnContent="开启"
                                                            Style="{StaticResource CompactToggleSwitchStyle}"
                                                            Toggled="ActionsToggle_Toggled" />
                                                    </Grid>
                                                    <ContentControl
                                                        HorizontalContentAlignment="Stretch"
                                                        IsEnabled="{Binding IsOn, ElementName=ContinuousSpecialDashLiinoToggle}">
                                                        <Border Style="{StaticResource SettingsRowStyle}">
                                                            <StackPanel Spacing="8">
                                                                <Grid ColumnSpacing="12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="13"
                                                                        FontWeight="Bold"
                                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                        Text="{Binding Header, ElementName=LiinoCleanDashToggle}" />
                                                                    <ToggleSwitch
                                                                        x:Name="LiinoCleanDashToggle"
                                                                        Grid.Column="1"
                                                                        Header="隐藏机甲与光效"
                                                                        IsEnabled="{Binding IsOn, ElementName=ContinuousSpecialDashLiinoToggle}"
                                                                        OffContent="关闭"
                                                                        OnContent="开启"
                                                                        Style="{StaticResource CompactToggleSwitchStyle}"
                                                                        Toggled="ActionsToggle_Toggled" />
                                                                </Grid>
                                                                <TextBlock
                                                                    x:Name="LiinoCleanDashDescription"
                                                                    Style="{StaticResource FieldHintStyle}"
                                                                    Text="梨诺冲刺全程隐藏机甲（含腿甲）与光效，保留飞行动画。"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </ContentControl>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 3: Jsspsi (祀) -->
                                            <Border Grid.Column="2" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                <StackPanel Spacing="14">
                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource SectionTitleStyle}"
                                                            Text="{Binding Header, ElementName=ContinuousSpecialDashJsspsiToggle}" />
                                                        <ToggleSwitch
                                                            x:Name="ContinuousSpecialDashJsspsiToggle"
                                                            Grid.Column="1"
                                                            Header="祀"
                                                            OffContent="关闭"
                                                            OnContent="开启"
                                                            Style="{StaticResource CompactToggleSwitchStyle}"
                                                            Toggled="ActionsToggle_Toggled" />
                                                    </Grid>
                                                    <ContentControl
                                                        HorizontalContentAlignment="Stretch"
                                                        IsEnabled="{Binding IsOn, ElementName=ContinuousSpecialDashJsspsiToggle}">
                                                        <Border Style="{StaticResource SettingsRowStyle}">
                                                            <StackPanel Spacing="8">
                                                                <Grid ColumnSpacing="12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        FontSize="13"
                                                                        FontWeight="Bold"
                                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                        Text="{Binding Header, ElementName=JsspsiQualityToggle}" />
                                                                    <ToggleSwitch
                                                                        x:Name="JsspsiQualityToggle"
                                                                        Grid.Column="1"
                                                                        Header="高质量过渡"
                                                                        IsEnabled="{Binding IsOn, ElementName=ContinuousSpecialDashJsspsiToggle}"
                                                                        OffContent="关闭"
                                                                        OnContent="开启"
                                                                        Style="{StaticResource CompactToggleSwitchStyle}"
                                                                        Toggled="ActionsToggle_Toggled" />
                                                                </Grid>
                                                                <TextBlock
                                                                    x:Name="JsspsiQualityDescription"
                                                                    Style="{StaticResource FieldHintStyle}"
                                                                    Text="补回尾巴、后发每圈甩动与回绕处的身体跳动：在接缝两侧逐帧改写祀和墨兽的骨骼，回绕改成硬切。关闭时使用轻量回绕。"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </ContentControl>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </controls:PageContentPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid
                            x:Name="CameraPageScrollViewer"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Fixed Page Header + Segmented Pill Tab Bar -->
                            <StackPanel Grid.Row="0" Padding="28,22,28,8" Spacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="CameraPageTitleTextBlock" Style="{StaticResource PageTitleStyle}" Text="相机增强" />
                                    <TextBlock
                                        x:Name="CameraPageDescriptionTextBlock"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="自由控制游戏相机，并调整镜头相关的画面效果。各项默认关闭，修改后立即保存。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        x:Name="CameraTabFreeButton"
                                        Tag="free"
                                        Content="自由视角与画面"
                                        Click="CameraWorkspaceTabButton_Click"
                                        Style="{StaticResource FilterPillSelectedButtonStyle}" />
                                    <Button
                                        x:Name="CameraTabMotionButton"
                                        Tag="motion"
                                        Content="运镜与 VMD"
                                        Click="CameraWorkspaceTabButton_Click"
                                        Style="{StaticResource FilterPillButtonStyle}" />
                                    <Button
                                        x:Name="CameraTabMmdButton"
                                        Tag="mmd"
                                        Content="MMD 播放与作品库"
                                        Click="CameraWorkspaceTabButton_Click"
                                        Style="{StaticResource FilterPillButtonStyle}" />
                                </StackPanel>
                                <Border Height="1" Margin="0,2,0,0" Background="{ThemeResource SubtleDividerBrush}" />
                            </StackPanel>

                            <!-- Row 1: Scrollable Workspace Area -->
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <controls:PageContentPanel Padding="28,8,28,28">
                                    <Grid>
                                        <!-- Tab 1: 自由视角与画面 -->
                                        <StackPanel x:Name="CameraTabFreePanel" Spacing="16" Visibility="Visible">
                                            <!-- Keep InfoBar instance for C# localization binding while rendering with HintBannerBorderStyle -->
                                            <InfoBar
                                                x:Name="CameraFreeInfoBar"
                                                IsClosable="False"
                                                IsOpen="True"
                                                Message="启用后按设置的热键进入或退出。鼠标转向，方向键前后左右移动，PageUp/PageDown 升降，Shift 加速、Ctrl 减速；冻结时间后仍可移动。切换场景或主相机时会自动退出。"
                                                Severity="Informational"
                                                Title="自由视角操作"
                                                Visibility="Collapsed" />

                                            <Border Style="{StaticResource HintBannerBorderStyle}">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        VerticalAlignment="Top"
                                                        Padding="10,3"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource AuxBadgeBackgroundBrush}">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Foreground="{ThemeResource AuxBadgeForegroundBrush}"
                                                            Text="{Binding Title, ElementName=CameraFreeInfoBar}" />
                                                    </Border>
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Message, ElementName=CameraFreeInfoBar}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>

                                            <Grid ColumnSpacing="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6*" />
                                                    <ColumnDefinition Width="5*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Card: Free Camera -->
                                                <Border Grid.Column="0" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                    <StackPanel Spacing="14">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock x:Name="CameraFreeSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="自由视角" />
                                                            <TextBlock
                                                                x:Name="CameraFreeSectionHint"
                                                                Style="{StaticResource FieldHintStyle}"
                                                                Text="进入时捕获主相机的位置、朝向和视野，退出后恢复原值。自由视角期间位置和朝向都由模块控制，不受时间冻结影响。"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>

                                                        <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                        <Grid ColumnSpacing="12" Padding="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=FreeCameraToggle}" />
                                                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding OnContent, ElementName=FreeCameraToggle}" />
                                                            </StackPanel>
                                                            <ToggleSwitch
                                                                x:Name="FreeCameraToggle"
                                                                Grid.Column="1"
                                                                Header="启用自由视角功能"
                                                                OffContent="关闭"
                                                                OnContent="允许热键切换"
                                                                Style="{StaticResource CompactToggleSwitchStyle}"
                                                                Toggled="CameraEnhancementToggle_Toggled" />
                                                        </Grid>

                                                        <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                        <Grid ColumnSpacing="12" Padding="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=FreeCameraFollowCharacterToggle}" />
                                                                <TextBlock
                                                                    x:Name="FreeCameraFollowHint"
                                                                    Style="{StaticResource FieldHintStyle}"
                                                                    Text="手动自由视角中跟随人物平移，保持镜头方向。切人、传送后重新建立参考；运镜播放时暂停跟随。"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <ToggleSwitch
                                                                x:Name="FreeCameraFollowCharacterToggle"
                                                                Grid.Column="1"
                                                                Header="自由镜头跟随人物移动"
                                                                OffContent="固定世界位置"
                                                                OnContent="保持相对位置，可手动调整"
                                                                Style="{StaticResource CompactToggleSwitchStyle}"
                                                                Toggled="CameraEnhancementToggle_Toggled" />
                                                        </Grid>

                                                        <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                        <Grid ColumnSpacing="12" Padding="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=PauseGameInFreeCameraToggle}" />
                                                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding OnContent, ElementName=PauseGameInFreeCameraToggle}" />
                                                            </StackPanel>
                                                            <ToggleSwitch
                                                                x:Name="PauseGameInFreeCameraToggle"
                                                                Grid.Column="1"
                                                                Header="启用时间冻结功能"
                                                                OffContent="不冻结世界"
                                                                OnContent="允许热键冻结"
                                                                Style="{StaticResource CompactToggleSwitchStyle}"
                                                                Toggled="CameraEnhancementToggle_Toggled" />
                                                        </Grid>

                                                        <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                        <Grid ColumnSpacing="12" RowSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <TextBox
                                                                x:Name="FreeCameraHotkeyBox"
                                                                Header="自由视角热键"
                                                                LostFocus="FreeCameraHotkeyBox_LostFocus"
                                                                MaxLength="8"
                                                                PlaceholderText="例如 9、F9、NUMPAD9"
                                                                Text="9" />
                                                            <TextBox
                                                                x:Name="PauseWorldHotkeyBox"
                                                                Grid.Column="1"
                                                                Header="时间冻结热键"
                                                                LostFocus="PauseWorldHotkeyBox_LostFocus"
                                                                MaxLength="8"
                                                                PlaceholderText="例如 8、F8、NUMPAD8"
                                                                Text="8" />
                                                            <NumberBox
                                                                x:Name="FreeCameraMovementSpeedNumberBox"
