                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right Column: Loader Mode + Appearance & Language + Steam Integration -->
                                    <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="LoaderModeSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="加载方式" />
                                                    <Border
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Padding="10,4"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource AuxBadgeBackgroundBrush}">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="Bold"
                                                            Foreground="{ThemeResource AuxBadgeForegroundBrush}"
                                                            Text="注入模式" />
                                                    </Border>
                                                </Grid>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource SettingsRowStyle}" Padding="12,10">
                                                        <RadioButton
                                                            x:Name="NoneModeRadioButton"
                                                            GroupName="LoaderMode"
                                                            IsChecked="True"
                                                            Checked="LoaderModeRadioButton_Checked">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock x:Name="NoneModeTitleTextBlock" FontWeight="SemiBold" Text="不注入" />
                                                                <TextBlock x:Name="NoneModeHintTextBlock" Style="{StaticResource FieldHintStyle}" Text="跳过启动器直启游戏" />
                                                            </StackPanel>
                                                        </RadioButton>
                                                    </Border>
                                                    <Border Grid.Column="1" Style="{StaticResource SettingsRowStyle}" Padding="12,10">
                                                        <RadioButton
                                                            x:Name="InjectorModeRadioButton"
                                                            GroupName="LoaderMode"
                                                            Checked="LoaderModeRadioButton_Checked">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock x:Name="InjectorModeTitleTextBlock" FontWeight="SemiBold" Text="内置注入器" />
                                                                <TextBlock x:Name="InjectorModeHintTextBlock" Style="{StaticResource FieldHintStyle}" Text="不写入游戏目录" />
                                                            </StackPanel>
                                                        </RadioButton>
                                                    </Border>
                                                    <Border Grid.Column="2" Style="{StaticResource SettingsRowStyle}" Padding="12,10">
                                                        <RadioButton
                                                            x:Name="XInputModeRadioButton"
                                                            GroupName="LoaderMode"
                                                            Checked="LoaderModeRadioButton_Checked">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock x:Name="XInputModeTitleTextBlock" FontWeight="SemiBold" Text="XInput 自启动" />
                                                                <TextBlock x:Name="XInputModeHintTextBlock" Style="{StaticResource FieldHintStyle}" Text="随游戏自动加载" />
                                                            </StackPanel>
                                                        </RadioButton>
                                                    </Border>
                                                </Grid>
                                                <TextBlock
                                                    x:Name="LoaderModeDescriptionTextBlock"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="由 Better Endfield Next 启动游戏并在启动阶段加载 Host，游戏目录保持不变。"
                                                    TextWrapping="Wrap" />
                                                <StackPanel
                                                    x:Name="XInputManagementPanel"
                                                    Spacing="12"
                                                    Visibility="Collapsed">
                                                    <InfoBar
                                                        x:Name="XInputWarningInfoBar"
                                                        IsClosable="False"
                                                        IsOpen="True"
                                                        Message="需要兼容其他加载器，或希望通过官方启动器、桌面快捷方式自启动时使用。安装会向 Endfield.exe 所在目录写入 xinput1_4.dll 和归属记录；不会覆盖未知同名文件。"
                                                        Severity="Informational"
                                                        Title="会写入游戏目录" />
                                                    <InfoBar
                                                        x:Name="XInputStatusInfoBar"
                                                        IsClosable="False"
                                                        IsOpen="True"
                                                        Message="正在检查安装状态。"
                                                        Severity="Informational"
                                                        Title="XInput 状态" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Button
                                                            x:Name="InstallXInputButton"
                                                            Click="InstallXInputButton_Click">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <SymbolIcon Symbol="Download" />
                                                                <TextBlock x:Name="InstallXInputButtonTextBlock" Text="安装或更新" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            x:Name="UninstallXInputButton"
                                                            Click="UninstallXInputButton_Click">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <SymbolIcon Symbol="Delete" />
                                                                <TextBlock x:Name="UninstallXInputButtonTextBlock" Text="从游戏目录卸载" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="14">
                                                <TextBlock x:Name="AppearanceSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="外观与语言" />
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox
                                                        x:Name="LanguageComboBox"
                                                        HorizontalAlignment="Stretch"
                                                        Header="界面语言 / Language"
                                                        SelectionChanged="LanguageComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="跟随系统 (System Default)" Tag="System" />
                                                        <ComboBoxItem Content="简体中文 (Chinese Simplified)" Tag="zh-CN" />
                                                        <ComboBoxItem Content="English (United States)" Tag="en-US" />
                                                    </ComboBox>
                                                    <ComboBox
                                                        x:Name="ThemeComboBox"
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Stretch"
                                                        Header="应用主题"
                                                        SelectionChanged="ThemeComboBox_SelectionChanged">
                                                        <ComboBoxItem x:Name="ThemeItemDefault" Content="跟随系统" Tag="Default" />
                                                        <ComboBoxItem x:Name="ThemeItemLight" Content="浅色" Tag="Light" />
                                                        <ComboBoxItem x:Name="ThemeItemDark" Content="深色" Tag="Dark" />
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <views:SteamIntegrationPage x:Name="SteamIntegrationPage" />
                                    </StackPanel>
                                </Grid>
                                </controls:PageContentPanel>
                            </ScrollViewer>
                        </Grid>

                        <ScrollViewer
                            x:Name="AboutPageScrollViewer"
                            HorizontalScrollBarVisibility="Disabled"
                            Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto">
                            <controls:PageContentPanel Padding="32,28,32,44">
                            <StackPanel
                                Spacing="30">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="76" Height="76" CornerRadius="8">
                                        <Image Source="Assets/shared/gilberta.png" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                        <TextBlock x:Name="AboutAppTitleTextBlock" Style="{StaticResource PageTitleStyle}" Text="Better Endfield Next" />
                                        <TextBlock
                                            x:Name="AboutAppSubtitleTextBlock"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="终末地登录场景模型与角色配音控制器" />
                                        <TextBlock
                                            x:Name="CurrentVersionTextBlock"
                                            Margin="0,2,0,0"
                                            FontFamily="Consolas"
                                            Text="版本 2.2.1" />
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock x:Name="AboutUpdateSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="软件更新" />
                                        <ToggleSwitch
                                            x:Name="AutoCheckUpdatesToggle"
                                            Header="启动时自动检查更新"
                                            IsOn="True"
                                            Toggled="AutoCheckUpdatesToggle_Toggled" />
                                        <TextBlock
                                            x:Name="AboutUpdateSectionHint"
                                            Style="{StaticResource FieldHintStyle}"
                                            Text="启动时自动检查 GitHub Releases，发现新版本时提示更新。" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="CheckUpdatesButton"
                                                Click="CheckUpdatesButton_Click"
                                                Style="{StaticResource AccentButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ProgressRing
                                                        x:Name="UpdateProgressRing"
                                                        Width="16"
                                                        Height="16"
                                                        IsActive="False"
                                                        Visibility="Collapsed" />
                                                    <SymbolIcon x:Name="UpdateButtonIcon" Symbol="Refresh" />
                                                    <TextBlock x:Name="CheckUpdatesButtonTextBlock" Text="检查更新" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="OpenReleaseButton"
                                                Click="OpenReleaseButton_Click"
                                                Visibility="Collapsed">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <SymbolIcon Symbol="Download" />
                                                    <TextBlock x:Name="OpenReleaseButtonTextBlock" Text="打开下载页" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <InfoBar
                                            x:Name="UpdateInfoBar"
                                            IsClosable="True"
                                            IsOpen="False" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock x:Name="AboutProjectSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="项目" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="ResourceUpdateButton" Content="更新基础资源" Click="ResourceUpdateButton_Click" />
                                            <Button x:Name="PreviewResourceButton" Content="下载预览资源" Click="PreviewResourceButton_Click" />
                                            <Button x:Name="ImportResourceButton" Content="导入资源包 / 回退" Click="ImportResourceButton_Click" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="ResumeResourceUpdatesButton" Content="恢复资源自动更新" Click="ResumeResourceUpdatesButton_Click" />
                                            <Button x:Name="CancelResourceUpdateButton" Content="取消下载" Click="CancelResourceUpdateButton_Click" IsEnabled="False" />
                                        </StackPanel>
                                        <TextBlock x:Name="ResourceUpdateStatus" Style="{StaticResource FieldHintStyle}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Click="OpenRepositoryButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <SymbolIcon Symbol="Link" />
                                                    <TextBlock x:Name="OpenRepoButtonTextBlock" Text="GitHub 仓库" />
                                                </StackPanel>
                                            </Button>
                                            <Button Click="OpenAllReleasesButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <SymbolIcon Symbol="Download" />
                                                    <TextBlock x:Name="OpenReleasesButtonTextBlock" Text="全部版本" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Left"
                                            Click="OpenLicenseButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <SymbolIcon Symbol="Document" />
                                                <TextBlock x:Name="OpenLicenseButtonTextBlock" Text="GNU AGPL v3.0 开源许可" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel Spacing="14">
                                        <TextBlock x:Name="AboutAuthorSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="作者与交流" />
                                        <Grid ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock x:Name="BilibiliLabelTextBlock" VerticalAlignment="Center" Text="B站" />
                                            <Button
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                Click="OpenBilibiliButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <SymbolIcon Symbol="Link" />
                                                    <TextBlock x:Name="OpenBilibiliButtonTextBlock" Text="打开 B站主页" />
                                                </StackPanel>
                                            </Button>

                                            <TextBlock x:Name="XiaoheiheLabelTextBlock" Grid.Row="1" VerticalAlignment="Center" Text="小黑盒" />
                                            <Button
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                Click="OpenXiaoheiheButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <SymbolIcon Symbol="Link" />
                                                    <TextBlock x:Name="OpenXiaoheiheButtonTextBlock" Text="打开小黑盒主页" />
                                                </StackPanel>
                                            </Button>

                                            <TextBlock x:Name="QqGroupLabelTextBlock" Grid.Row="2" VerticalAlignment="Center" Text="QQ群" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontFamily="Consolas"
                                                IsTextSelectionEnabled="True"
                                                Text="851586605" />
                                            <Button
                                                x:Name="CopyQqGroupButton"
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Width="40"
                                                Height="32"
                                                Padding="8"
                                                Click="CopyQqGroupButton_Click"
                                                ToolTipService.ToolTip="复制QQ群号">
                                                <SymbolIcon Symbol="Copy" />
                                            </Button>
                                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Discord" />
                                            <Button
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                HorizontalAlignment="Left"
                                                Click="OpenDiscordButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <SymbolIcon Symbol="Link" />
                                                    <TextBlock x:Name="OpenDiscordButtonTextBlock" Text="Discord 社区" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="AboutDisclaimerSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="风险与免责声明" />
                                        <TextBlock
                                            x:Name="AboutDisclaimerHintTextBlock"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="本项目为非官方实验工具，与鹰角网络、峘形山工作室及 GRYPHLINE 无关。注入和运行时修改可能造成游戏崩溃、版本不兼容或账号风险。"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Name="ViewDisclaimerButton"
                                            HorizontalAlignment="Left"
                                            Click="ViewDisclaimerButton_Click"
                                            Content="查看完整说明" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </controls:PageContentPanel>
                        </ScrollViewer>
                    </Grid>

                        <Border
                            x:Name="ActionBar"
                            Grid.Row="1"
                            Margin="28,0,28,0"
                            Padding="4,14,4,16"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="PageSelectionHintTextBlock"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="保存后在下一次注入时生效。"
                                    TextTrimming="CharacterEllipsis" />
                                <Button
                                    x:Name="ResetButton"
                                    Grid.Column="1"
                                    Height="40"
                                    CornerRadius="14"
                                    Padding="18,0"
                                    Background="{ThemeResource NavSelectedPillBrush}"
                                    BorderBrush="{ThemeResource StatusCardBorderBrush}"
                                    BorderThickness="1.5"
                                    Click="ResetButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="Undo" />
                                        <TextBlock x:Name="ResetButtonTextBlock" FontWeight="SemiBold" Text="恢复默认" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="SaveButton"
                                    Grid.Column="2"
                                    Height="40"
                                    CornerRadius="14"
                                    Padding="18,0"
                                    Background="{ThemeResource NavSelectedPillBrush}"
                                    BorderBrush="{ThemeResource StatusCardBorderBrush}"
                                    BorderThickness="1.5"
                                    Click="SaveButton_Click"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="Save" />
                                        <TextBlock x:Name="SaveButtonTextBlock" FontWeight="SemiBold" Text="保存" />
                                    </StackPanel>
                                </Button>
                                <Grid Grid.Column="3">
                                    <!-- Underlying Warm Shadow Projection -->
                                    <Border
                                        Margin="4,8,4,-6"
                                        CornerRadius="14"
                                        IsHitTestVisible="False">
                                        <Border.Background>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.6" RadiusY="0.7">
                                                <GradientStop Color="{ThemeResource AccentWarmShadowColor}" Offset="0.0" />
                                                <GradientStop Color="#00000000" Offset="1.0" />
                                            </RadialGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Button
                                        x:Name="LaunchButton"
                                        Height="40"
                                        CornerRadius="14"
                                        Padding="22,0"
                                        Click="LaunchButton_Click"
                                        Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ProgressRing
                                                x:Name="LaunchProgressRing"
                                                Width="16"
                                                Height="16"
                                                IsActive="False"
                                                Visibility="Collapsed" />
                                            <SymbolIcon Symbol="Play" />
                                            <TextBlock x:Name="LaunchButtonTextBlock" FontWeight="Bold" Text="启动" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <InfoBar
                            x:Name="StatusInfoBar"
                            Grid.Row="2"
                            Margin="28,4,28,12"
                            IsClosable="True"
                            IsOpen="False" />
                    </Grid>
                </Border>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
