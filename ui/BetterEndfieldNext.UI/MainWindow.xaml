<Window
    x:Class="BetterEndfieldNext.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterEndfieldNext.UI.Controls"
    xmlns:views="using:BetterEndfieldNext.UI.Views">

    <Grid
        x:Name="MainRoot"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="MainRoot_Loaded">
        <Grid.Resources>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="FieldHintStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionStyle" TargetType="Border">
                <Setter Property="Padding" Value="22,20" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>
            <Style x:Key="SettingsRowStyle" TargetType="Border">
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Background" Value="{ThemeResource SubTileBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="PathButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </Grid.Resources>

        <!-- L1 底层 4 组莫奈柔光场 -->
        <Grid IsHitTestVisible="False">
            <Rectangle Fill="{ThemeResource MonetGlowBrush1}"/>
            <Rectangle Fill="{ThemeResource MonetGlowBrush2}"/>
            <Rectangle Fill="{ThemeResource MonetGlowBrush3}"/>
            <Rectangle Fill="{ThemeResource MonetGlowBrush4}"/>
        </Grid>

        <NavigationView
            x:Name="FeatureNavigation"
            CompactModeThresholdWidth="720"
            CompactPaneLength="48"
            ExpandedModeThresholdWidth="1000"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="236"
            PaneDisplayMode="Left"
            ItemInvoked="FeatureNavigation_ItemInvoked"
            SelectionChanged="FeatureNavigation_SelectionChanged">
            <NavigationView.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush Color="Transparent" x:Key="NavigationViewExpandedPaneBackground"/>
                            <SolidColorBrush Color="#F2F0ECF7" x:Key="NavigationViewDefaultPaneBackground"/>
                            <SolidColorBrush Color="Transparent" x:Key="NavigationViewTopPaneBackground"/>
                            <SolidColorBrush Color="Transparent" x:Key="NavigationViewContentBackground"/>
                            <SolidColorBrush Color="Transparent" x:Key="NavigationViewContentGridBorderBrush"/>

                            <SolidColorBrush Color="#FFFFFFFF" x:Key="NavigationViewItemBackgroundSelected"/>
                            <SolidColorBrush Color="#FFFFFFFF" x:Key="NavigationViewItemBackgroundSelectedPointerOver"/>
                            <SolidColorBrush Color="#F5FFFFFF" x:Key="NavigationViewItemBackgroundSelectedPressed"/>
                            <SolidColorBrush Color="#245B5768" x:Key="NavigationViewItemBorderBrushSelected"/>
                            <SolidColorBrush Color="#335B5768" x:Key="NavigationViewItemBorderBrushSelectedPointerOver"/>
                            <SolidColorBrush Color="#99FFFFFF" x:Key="NavigationViewItemBackgroundPointerOver"/>
                            <SolidColorBrush Color="#B8FFFFFF" x:Key="NavigationViewItemBackgroundPressed"/>
                            <SolidColorBrush Color="#FFD66853" x:Key="NavigationViewSelectionIndicatorForeground"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush Color="Transparent" x:Key="NavigationViewExpandedPaneBackground"/>
                            <SolidColorBrush Color="#F21E1F24" x:Key="NavigationViewDefaultPaneBackground"/>
                            <SolidColorBrush Color="Transparent" x:Key="NavigationViewTopPaneBackground"/>
                            <SolidColorBrush Color="Transparent" x:Key="NavigationViewContentBackground"/>
                            <SolidColorBrush Color="Transparent" x:Key="NavigationViewContentGridBorderBrush"/>

                            <SolidColorBrush Color="#1FFFFFFF" x:Key="NavigationViewItemBackgroundSelected"/>
                            <SolidColorBrush Color="#29FFFFFF" x:Key="NavigationViewItemBackgroundSelectedPointerOver"/>
                            <SolidColorBrush Color="#14FFFFFF" x:Key="NavigationViewItemBackgroundSelectedPressed"/>
                            <SolidColorBrush Color="#2EFFFFFF" x:Key="NavigationViewItemBorderBrushSelected"/>
                            <SolidColorBrush Color="#3DFFFFFF" x:Key="NavigationViewItemBorderBrushSelectedPointerOver"/>
                            <SolidColorBrush Color="#14FFFFFF" x:Key="NavigationViewItemBackgroundPointerOver"/>
                            <SolidColorBrush Color="#0FFFFFFF" x:Key="NavigationViewItemBackgroundPressed"/>
                            <SolidColorBrush Color="#FFE07A64" x:Key="NavigationViewSelectionIndicatorForeground"/>
                            <SolidColorBrush Color="#CCFFFFFF" x:Key="NavigationViewItemForeground"/>
                            <SolidColorBrush Color="#FFFFFFFF" x:Key="NavigationViewItemForegroundPointerOver"/>
                            <SolidColorBrush Color="#FFFFFFFF" x:Key="NavigationViewItemForegroundSelected"/>
                            <SolidColorBrush Color="#FFFFFFFF" x:Key="NavigationViewItemForegroundSelectedPointerOver"/>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <Thickness x:Key="NavigationViewItemBorderThickness">1</Thickness>
                    <Style TargetType="NavigationViewItem">
                        <Setter Property="Margin" Value="10,2,10,2" />
                        <Setter Property="CornerRadius" Value="14" />
                    </Style>
                </ResourceDictionary>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <Grid Margin="14,18,10,14" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="{ThemeResource AccentButtonBackground}">
                        <Grid>
                            <Image Source="Assets/shared/gilberta.png" Stretch="UniformToFill" Opacity="0.92" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="15" FontWeight="Bold" Text="Better Endfield" />
                        <TextBlock
                            x:Name="PaneSubtitleTextBlock"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="v4.2.0 · 终末地控制器" />
                    </StackPanel>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="ModelNavigationItem"
                    Content="开屏"
                    IsSelected="True"
                    Tag="model">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="VoiceNavigationItem"
                    Content="配音语言"
                    Tag="voice">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE767;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="MusicNavigationItem"
                    Content="音乐集成"
                    Tag="music">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="CombatNavigationItem"
                    Content="战斗数据"
                    Tag="combat">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="UiNavigationItem"
                    Content="界面增强"
                    Tag="ui">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE740;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ActionsNavigationItem" Content="动作模块" Tag="actions">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MediaScreenNavigationItem" Content="会客室媒体屏" Tag="media-screen">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE714;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="CameraNavigationItem"
                    Content="相机增强"
                    Tag="camera">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE722;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="DisplayNavigationItem"
                    Content="显示增强"
                    Tag="display"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="GachaNavigationItem"
                    Content="寻访查询"
                    Tag="gacha">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CustomModelNavigationItem" Content="角色外观" Tag="custom-model">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE771;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WeaponAppearanceNavigationItem" Content="管理员外观" Tag="weapon-appearance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="WorkshopNavigationItem" Content="创意工坊" Tag="workshop">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE719;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SponsorNavigationItem"
                    Margin="10,2,10,2"
                    CornerRadius="14"
                    Content="给作者充一点token"
                    Foreground="{ThemeResource SponsorForegroundBrush}"
                    SelectsOnInvoked="False"
                    Tag="sponsor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB52;" Foreground="{ThemeResource NavSelectedIndicatorBrush}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AboutNavigationItem"
                    Margin="10,2,10,2"
                    CornerRadius="14"
                    Content="关于"
                    Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <Border
                    Margin="12,8,12,10"
                    Padding="14,12"
                    CornerRadius="16"
                    Background="{ThemeResource StatusCardBackgroundBrush}"
                    BorderBrush="{ThemeResource StatusCardBorderBrush}"
                    BorderThickness="1.5">
                    <StackPanel Spacing="3">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                x:Name="RuntimeStatusIndicator"
                                Width="9"
                                Height="9"
                                VerticalAlignment="Center"
                                Fill="#FF968EAD" />
                            <TextBlock
                                x:Name="RuntimeStatusTextBlock"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="Bold"
                                Text="正在检查运行状态…"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock
                            x:Name="LogStatusTextBlock"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="11"
                            Text="尚未发现日志"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <NavigationView.Content>
                <Border
                    Margin="6,32,16,14"
                    CornerRadius="22"
                    Background="{ThemeResource ContentSheetBackgroundBrush}"
                    BorderBrush="{ThemeResource ContentSheetBorderBrush}"
                    BorderThickness="1.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <views:GachaPage x:Name="GachaPage" Visibility="Collapsed" />
                            <views:MediaScreenPage x:Name="MediaScreenPage" Visibility="Collapsed" />
                            <views:CustomModelPage x:Name="CustomModelPage" Visibility="Collapsed" />
                            <views:WeaponAppearancePage x:Name="WeaponAppearancePage" Visibility="Collapsed" />
                            <views:WorkshopPage x:Name="WorkshopPage" Visibility="Collapsed" />
                            <Grid x:Name="ModelPageScrollViewer">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Fixed Page Header (Never scrolls off-screen) -->
                                <Grid Grid.Row="0" Padding="28,22,28,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="ModelPageTitleTextBlock" Style="{StaticResource PageTitleStyle}" Text="开屏" />
                                        <TextBlock
                                            x:Name="ModelPageDescriptionTextBlock"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="调整登录场景的视觉效果、角色模型与四阶段动画。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Padding="14,6"
                                        CornerRadius="14"
                                        Background="{ThemeResource AuxBadgeBackgroundBrush}">
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Foreground="{ThemeResource AuxBadgeForegroundBrush}"
                                            Text="鸢尾温室 · 场景定制" />
                                    </Border>
                                </Grid>

                                <!-- Row 1: Scrollable Cards Area -->
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <controls:PageContentPanel Padding="28,4,28,20">
                                        <Grid ColumnSpacing="18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="5*" />
                                                <ColumnDefinition Width="7*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Column: Visual & Master Toggle Card + Playback Speed Card -->
                                            <StackPanel Grid.Column="0" Spacing="18" VerticalAlignment="Top">
                                                <Border Style="{StaticResource SectionStyle}">
                                                    <StackPanel Spacing="16">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="3">
                                                                <TextBlock x:Name="ModelVisualSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="界面视觉" />
                                                                <TextBlock
                                                                    x:Name="ModelVisualSectionHint"
                                                                    Style="{StaticResource FieldHintStyle}"
                                                                    Text="主题色可与原登录演员或角色替换同时使用。" />
                                                            </StackPanel>
                                                            <Border
                                                                Grid.Column="1"
                                                                VerticalAlignment="Top"
                                                                Padding="10,4"
                                                                CornerRadius="8"
                                                                Background="{ThemeResource AccentBadgeBackgroundBrush}">
                                                                <TextBlock
                                                                    FontSize="11"
                                                                    FontWeight="Bold"
                                                                    Foreground="{ThemeResource AccentBadgeForegroundBrush}"
                                                                    Text="实时生效" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- Left Title + Right Switch Row 1 -->
                                                        <Grid ColumnSpacing="12" Padding="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock
                                                                    x:Name="LogoThemeRowTitle"
                                                                    FontSize="14"
                                                                    FontWeight="Bold"
                                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                    Text="自定义 Logo 与色带主题色" />
                                                                <TextBlock
                                                                    x:Name="LogoThemeRowHint"
                                                                    Style="{StaticResource FieldHintStyle}"
                                                                    Text="覆盖登录界面色带与标志颜色" />
                                                            </StackPanel>
                                                            <ToggleSwitch
                                                                x:Name="LogoThemeToggle"
                                                                Grid.Column="1"
                                                                Style="{StaticResource CompactToggleSwitchStyle}"
                                                                OffContent=""
                                                                OnContent="" />
                                                        </Grid>

                                                        <!-- Sleek Color Swatch Trigger Bar + Flyout ColorPicker (No more 250px rainbow wheel on page!) -->
                                                        <ContentControl
                                                            HorizontalContentAlignment="Stretch"
                                                            IsEnabled="{Binding IsOn, ElementName=LogoThemeToggle}">
                                                            <Button
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch"
                                                                Background="{ThemeResource SubTileBackgroundBrush}"
                                                                BorderThickness="0"
                                                                CornerRadius="12"
                                                                Padding="14,10">
                                                                <Grid ColumnSpacing="12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border
                                                                        x:Name="LogoThemeColorPreviewBorder"
                                                                        Width="28"
                                                                        Height="28"
                                                                        CornerRadius="8"
                                                                        Background="#FFFFC928"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1.5" />
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                        <TextBlock
                                                                            x:Name="LogoThemeColorFlyoutTitle"
                                                                            FontSize="13"
                                                                            FontWeight="Bold"
                                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                            Text="主题强调色" />
                                                                        <TextBlock
                                                                            x:Name="LogoThemeColorHexTextBlock"
                                                                            FontSize="12"
                                                                            FontFamily="Consolas"
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            Text="#FFC928 · 点击展开调色盘" />
                                                                    </StackPanel>
                                                                    <FontIcon
                                                                        Grid.Column="2"
                                                                        Glyph="&#xE70D;"
                                                                        FontSize="12"
                                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                                </Grid>
                                                                <Button.Flyout>
                                                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                                                        <ColorPicker
                                                                            x:Name="LogoThemeColorPicker"
                                                                            Color="#FFFFC928"
                                                                            ColorSpectrumShape="Ring"
                                                                            IsAlphaEnabled="False"
                                                                            IsColorChannelTextInputVisible="True"
                                                                            IsColorPreviewVisible="True"
                                                                            IsHexInputVisible="True"
                                                                            IsMoreButtonVisible="False"
                                                                            ColorChanged="LogoThemeColorPicker_ColorChanged"
                                                                            Loaded="LogoThemeColorPicker_Loaded" />
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                        </ContentControl>

                                                        <Border Height="1" Background="{ThemeResource SubtleRowDividerBrush}" />

                                                        <!-- Left Title + Right Switch Row 2 -->
                                                        <Grid ColumnSpacing="12" Padding="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock
                                                                    x:Name="ModelReplacementRowTitle"
                                                                    FontSize="14"
                                                                    FontWeight="Bold"
                                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                    Text="启用开屏角色替换" />
                                                                <TextBlock
                                                                    x:Name="ModelReplacementRowHint"
                                                                    Style="{StaticResource FieldHintStyle}"
                                                                    Text="使用右侧指定角色与四阶段动作" />
                                                            </StackPanel>
                                                            <ToggleSwitch
                                                                x:Name="ModelReplacementToggle"
                                                                Grid.Column="1"
                                                                Style="{StaticResource CompactToggleSwitchStyle}"
                                                                OffContent=""
                                                                OnContent="" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <ContentControl
                                                    HorizontalContentAlignment="Stretch"
                                                    IsEnabled="{Binding IsOn, ElementName=ModelReplacementToggle}">
                                                    <Border Style="{StaticResource SectionStyle}">
                                                        <StackPanel Spacing="16">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock x:Name="ModelSpeedSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="播放速度" />
                                                                    <TextBlock
                                                                        x:Name="ModelSpeedSectionHint"
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="1.0 为原速，各阶段独立设置。" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Top"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource CardTagTextBrush}"
                                                                    Text="四阶段倍率" />
                                                            </Grid>
                                                            <Grid ColumnSpacing="12" RowSpacing="14">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <NumberBox
                                                                    x:Name="SitLoopSpeedNumberBox"
                                                                    FontWeight="Bold"
                                                                    Header="坐姿循环"
                                                                    Maximum="4"
                                                                    Minimum="0.1"
                                                                    SmallChange="0.1" />
                                                                <NumberBox
                                                                    x:Name="SitSpecialSpeedNumberBox"
                                                                    Grid.Column="1"
                                                                    FontWeight="Bold"
                                                                    Header="坐姿小动作"
                                                                    Maximum="4"
                                                                    Minimum="0.1"
                                                                    SmallChange="0.1" />
                                                                <NumberBox
                                                                    x:Name="SitToWalkSpeedNumberBox"
                                                                    Grid.Row="1"
                                                                    FontWeight="Bold"
                                                                    Header="起身过渡"
                                                                    Maximum="4"
                                                                    Minimum="0.1"
                                                                    SmallChange="0.1" />
                                                                <NumberBox
                                                                    x:Name="FinalSpeedNumberBox"
                                                                    Grid.Row="1"
                                                                    Grid.Column="1"
                                                                    FontWeight="Bold"
                                                                    Header="最后动作"
                                                                    Maximum="4"
                                                                    Minimum="0.1"
                                                                    SmallChange="0.1" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </ContentControl>
                                            </StackPanel>

                                            <!-- Right Column: Character & Action Card + Continuous Loop Card -->
                                            <ContentControl
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                HorizontalContentAlignment="Stretch"
                                                IsEnabled="{Binding IsOn, ElementName=ModelReplacementToggle}">
                                                <StackPanel Spacing="14" VerticalAlignment="Top">
                                                    <Border Style="{StaticResource SectionStyle}" Padding="22,16">
                                                        <StackPanel Spacing="10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock x:Name="ModelCharacterSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="角色与动作" />
                                                                    <TextBlock
                                                                        x:Name="ModelCharacterSectionHint"
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="角色使用自己的坐姿动画链，最后动作从该角色的已索引动画中选择。" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Top"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource CardTagTextBrush}"
                                                                    Text="演员与镜头" />
                                                            </Grid>
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <ComboBox
                                                                    x:Name="CharacterComboBox"
                                                                    FontWeight="Bold"
                                                                    HorizontalAlignment="Stretch"
                                                                    Header="角色模型"
                                                                    DisplayMemberPath="DisplayName"
                                                                    SelectionChanged="CharacterComboBox_SelectionChanged" />
                                                                <ComboBox
                                                                    x:Name="FinalActionComboBox"
                                                                    Grid.Column="1"
                                                                    FontWeight="Bold"
                                                                    HorizontalAlignment="Stretch"
                                                                    Header="最后动作"
                                                                    DisplayMemberPath="DisplayName"
                                                                    SelectionChanged="FinalActionComboBox_SelectionChanged" />
                                                            </Grid>
                                                            <Border Style="{StaticResource SettingsRowStyle}" Padding="12,8">
                                                                <StackPanel Spacing="2">
                                                                    <TextBlock
                                                                        x:Name="ActionDurationTextBlock"
                                                                        FontWeight="Bold" />
                                                                    <TextBlock
                                                                        x:Name="ActionDescriptionTextBlock"
                                                                        Style="{StaticResource FieldHintStyle}" />
                                                                    <TextBlock
                                                                        x:Name="PresetDetailsTextBlock"
                                                                        Style="{StaticResource FieldHintStyle}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Grid ColumnSpacing="12" RowSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                <NumberBox
                                                                    x:Name="StartYawNumberBox"
                                                                    FontWeight="Bold"
                                                                    Header="起始角度 (°)"
                                                                    Maximum="360"
                                                                    Minimum="-360"
                                                                    SmallChange="1" />
                                                                <NumberBox
                                                                    x:Name="TurnDurationNumberBox"
                                                                    Grid.Column="1"
                                                                    FontWeight="Bold"
                                                                    Header="转正时长 (秒)"
                                                                    Maximum="15"
                                                                    Minimum="0.1"
                                                                    SmallChange="0.1" />
                                                                <NumberBox
                                                                    x:Name="ScaleNumberBox"
                                                                    Grid.Row="1"
                                                                    FontWeight="Bold"
                                                                    Header="模型缩放"
                                                                    Maximum="2"
                                                                    Minimum="0.5"
                                                                    SmallChange="0.05" />
                                                                <NumberBox
                                                                    x:Name="LeanSampleNumberBox"
                                                                    Grid.Row="1"
                                                                    Grid.Column="1"
                                                                    FontWeight="Bold"
                                                                    Header="前倾采样 (秒)"
                                                                    Maximum="5"
                                                                    Minimum="0"
                                                                    SmallChange="0.1" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Style="{StaticResource SectionStyle}" Padding="22,16">
                                                        <StackPanel Spacing="7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock x:Name="ModelLoopSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="连续循环" />
                                                                    <TextBlock
                                                                        x:Name="ModelLoopSectionHint"
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="可遵循资源 LoopTime、强制循环，或按自定义区间交叉混合。" />
                                                                </StackPanel>
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Top"
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{ThemeResource CardTagTextBrush}"
                                                                    Text="循环控制" />
                                                            </Grid>

                                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        x:Name="FinalLoopRowTitle"
                                                                        FontSize="14"
                                                                        FontWeight="Bold"
                                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                        Text="原生循环" />
                                                                    <TextBlock
                                                                        x:Name="FinalLoopRowHint"
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="使用动画资源自带 LoopTime，否则停在末帧" />
                                                                </StackPanel>
                                                                <ToggleSwitch
                                                                    x:Name="FinalLoopToggle"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource CompactToggleSwitchStyle}"
                                                                    OffContent=""
                                                                    OnContent="" />
                                                            </Grid>

                                                            <Border Height="1" Background="{ThemeResource SubtleRowDividerBrush}" />

                                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        x:Name="ForceLoopRowTitle"
                                                                        FontSize="14"
                                                                        FontWeight="Bold"
                                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                        Text="强制循环" />
                                                                    <TextBlock
                                                                        x:Name="ForceLoopRowHint"
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="强制覆盖非循环动画并忽略末帧停留" />
                                                                </StackPanel>
                                                                <ToggleSwitch
                                                                    x:Name="ForceLoopToggle"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource CompactToggleSwitchStyle}"
                                                                    OffContent=""
                                                                    OnContent="" />
                                                            </Grid>

                                                            <Border Height="1" Background="{ThemeResource SubtleRowDividerBrush}" />

                                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        x:Name="CrossfadeRowTitle"
                                                                        FontSize="14"
                                                                        FontWeight="Bold"
                                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                        Text="首尾交叉过渡" />
                                                                    <TextBlock
                                                                        x:Name="CrossfadeRowHint"
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="按自定义起止区间平滑交叉混合" />
                                                                </StackPanel>
                                                                <ToggleSwitch
                                                                    x:Name="CrossfadeToggle"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource CompactToggleSwitchStyle}"
                                                                    OffContent=""
                                                                    OnContent=""
                                                                    Toggled="CrossfadeToggle_Toggled" />
                                                            </Grid>

                                                            <Grid
                                                                x:Name="CrossfadeSettingsPanel"
                                                                ColumnSpacing="12"
                                                                RowSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <NumberBox
                                                                    x:Name="LoopStartNumberBox"
                                                                    FontWeight="Bold"
                                                                    Header="循环起点 (秒)"
                                                                    Maximum="30"
                                                                    Minimum="0"
                                                                    SmallChange="0.05" />
                                                                <NumberBox
                                                                    x:Name="LoopEndNumberBox"
                                                                    Grid.Column="1"
                                                                    FontWeight="Bold"
                                                                    Header="循环终点 (秒)"
                                                                    Maximum="60"
                                                                    Minimum="0.05"
                                                                    SmallChange="0.05" />
                                                                <NumberBox
                                                                    x:Name="CrossfadeDurationNumberBox"
                                                                    Grid.Column="2"
                                                                    FontWeight="Bold"
                                                                    Header="混合时长 (秒)"
                                                                    Maximum="10"
                                                                    Minimum="0.01"
                                                                    SmallChange="0.05" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ContentControl>
                                        </Grid>
                                    </controls:PageContentPanel>
                                </ScrollViewer>
                            </Grid>

                        <Grid
                            x:Name="VoicePageScrollViewer"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Fixed Page Header -->
                            <Grid Grid.Row="0" Padding="28,22,28,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="VoicePageTitleTextBlock" Style="{StaticResource PageTitleStyle}" Text="配音语言" />
                                    <TextBlock
                                        x:Name="VoicePageDescriptionTextBlock"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="为单个角色指定语音包，同时保持游戏全局语言不变。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Padding="14,6"
                                    CornerRadius="14"
                                    Background="{ThemeResource AuxBadgeBackgroundBrush}">
                                    <TextBlock
                                        x:Name="VoicePageDownloadHintTextBlock"
                                        Foreground="{ThemeResource AuxBadgeForegroundBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="请先下载对应语言包。" />
                                </Border>
                            </Grid>

                            <!-- Row 1: Scrollable Body -->
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <controls:PageContentPanel Padding="28,4,28,28">
                                    <StackPanel Spacing="16">
                                        <!-- Top Master Switch Horizontal Card (2-Column) -->
                                        <Border Style="{StaticResource SectionStyle}" Padding="22,16">
                                            <Grid ColumnSpacing="24">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" ColumnSpacing="12" Padding="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                            Text="{Binding Header, ElementName=VoiceRouterToggle}"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Style="{StaticResource FieldHintStyle}"
                                                            Text="{Binding OnContent, ElementName=VoiceRouterToggle}" />
                                                    </StackPanel>
                                                    <ToggleSwitch
                                                        x:Name="VoiceRouterToggle"
                                                        Grid.Column="1"
                                                        Header="启用按角色配音"
                                                        OffContent="全部跟随游戏"
                                                        OnContent="应用下方角色规则"
                                                        Style="{StaticResource CompactToggleSwitchStyle}" />
                                                </Grid>

                                                <Border Grid.Column="1" Width="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                <ContentControl
                                                    Grid.Column="2"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding IsOn, ElementName=VoiceRouterToggle}">
                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock
                                                                FontSize="14"
                                                                FontWeight="Bold"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                Text="{Binding Header, ElementName=NarrativeVoiceToggle}"
                                                                TextWrapping="Wrap" />
                                                            <TextBlock
                                                                Style="{StaticResource FieldHintStyle}"
                                                                Text="{Binding OnContent, ElementName=NarrativeVoiceToggle}" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            x:Name="NarrativeVoiceToggle"
                                                            Grid.Column="1"
                                                            Header="替换剧情语音与口型"
                                                            OffContent="剧情对话跟随游戏语言"
                                                            OnContent="剧情对话应用角色规则"
                                                            Style="{StaticResource CompactToggleSwitchStyle}" />
                                                    </Grid>
                                                </ContentControl>
                                            </Grid>
                                        </Border>

                                        <!-- Bottom 2-Column Layout -->
                                        <ContentControl
                                            HorizontalContentAlignment="Stretch"
                                            IsEnabled="{Binding IsOn, ElementName=VoiceRouterToggle}">
                                            <Grid ColumnSpacing="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="5*" />
                                                    <ColumnDefinition Width="6*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Card: Set Character Language -->
                                                <Border Grid.Column="0" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                    <StackPanel Spacing="16">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock x:Name="VoiceRuleSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="设置角色语言" />
                                                            <TextBlock
                                                                x:Name="VoiceRuleSectionHint"
                                                                Style="{StaticResource FieldHintStyle}"
                                                                Text="同一角色再次添加时会更新现有规则。" />
                                                        </StackPanel>
                                                        <ComboBox
                                                            x:Name="VoiceCharacterComboBox"
                                                            HorizontalAlignment="Stretch"
                                                            MaxWidth="380"
                                                            Header="角色"
                                                            DisplayMemberPath="DisplayName"
                                                            SelectionChanged="VoiceCharacterComboBox_SelectionChanged" />
                                                        <RadioButtons
                                                            x:Name="VoiceLanguageRadioButtons"
                                                            Header="配音语言"
                                                            MaxColumns="5">
                                                            <RadioButtons.Resources>
                                                                <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
                                                                    <Setter Property="MinWidth" Value="0" />
                                                                    <Setter Property="Margin" Value="0,0,10,0" />
                                                                </Style>
                                                            </RadioButtons.Resources>
                                                            <RadioButton Content="中文" Tag="Chinese" />
                                                            <RadioButton Content="English" Tag="English" />
                                                            <RadioButton Content="日本語" Tag="Japanese" />
                                                            <RadioButton Content="한국어" Tag="Korean" />
                                                            <RadioButton Content="跟随游戏" Tag="FollowGlobal" />
                                                        </RadioButtons>
                                                        <Button
                                                            HorizontalAlignment="Right"
                                                            Click="AddVoiceRuleButton_Click"
                                                            Style="{StaticResource AccentButtonStyle}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <SymbolIcon Symbol="Add" />
                                                                <TextBlock x:Name="VoiceAddRuleButtonTextBlock" Text="添加或更新规则" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Right Card: Configured Characters -->
                                                <Border Grid.Column="1" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                    <StackPanel Spacing="14">
                                                        <TextBlock x:Name="VoiceConfiguredSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="已配置角色" />
                                                        <Border Style="{StaticResource HintBannerBorderStyle}">
                                                            <TextBlock
                                                                x:Name="VoiceRulesEmptyTextBlock"
                                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                Text="尚未配置角色，将全部跟随游戏全局语言。"
                                                                TextWrapping="Wrap" />
                                                        </Border>
                                                        <ListView
                                                            x:Name="VoiceRulesListView"
                                                            MaxHeight="360"
                                                            SelectionMode="None">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid MinHeight="52" Padding="4,6" ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="120" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <TextBlock
                                                                                FontWeight="SemiBold"
                                                                                Text="{Binding DisplayName}"
                                                                                TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBlock
                                                                            Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                            Text="{Binding LanguageDisplayName}" />
                                                                        <Button
                                                                            Grid.Column="2"
                                                                            Click="RemoveVoiceRuleButton_Click"
                                                                            Tag="{Binding Speaker}"
                                                                            ToolTipService.ToolTip="删除规则">
                                                                            <SymbolIcon Symbol="Delete" />
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </ContentControl>
                                    </StackPanel>
                                </controls:PageContentPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid
                            x:Name="MusicPageScrollViewer"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Fixed Page Header -->
                            <StackPanel Grid.Row="0" Padding="28,22,28,12" Spacing="4">
                                <TextBlock x:Name="MusicPageTitleTextBlock" Style="{StaticResource PageTitleStyle}" Text="OmniMix 音乐集成" />
                                <TextBlock
                                    x:Name="MusicPageDescriptionTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="将 OmniMix 输出的音乐送入游戏原生 Wwise 音乐总线。曲库、播放列表与后端仍由 OmniMix 管理。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Row 1: Scrollable Body -->
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <controls:PageContentPanel Padding="28,4,28,28">
                                    <StackPanel Spacing="16">
                                        <!-- Top Master Switch Horizontal Card -->
                                        <Border Style="{StaticResource SectionStyle}" Padding="22,16">
                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding Header, ElementName=MusicReplacementToggle}"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Style="{StaticResource FieldHintStyle}"
                                                        Text="{Binding OnContent, ElementName=MusicReplacementToggle}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="MusicReplacementToggle"
                                                    Grid.Column="1"
                                                    Header="启用音乐替换"
                                                    OffContent="保持游戏原生音乐"
                                                    OnContent="使用 OmniMix 音乐流"
                                                    Style="{StaticResource CompactToggleSwitchStyle}" />
                                            </Grid>
                                        </Border>

                                        <!-- Bottom 2-Column Layout -->
                                        <ContentControl HorizontalContentAlignment="Stretch">
                                            <Grid ColumnSpacing="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Column: OmniMix Backend + Replacement Scope -->
                                                <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Top">
                                                    <Border Style="{StaticResource SectionStyle}">
                                                        <StackPanel Spacing="14">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock x:Name="MusicBackendSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="OmniMix 后端" />
                                                                <TextBlock
                                                                    x:Name="MusicBackendSectionHint"
                                                                    Style="{StaticResource FieldHintStyle}"
                                                                    Text="Better Endfield Next 只保存后端绝对路径，不复制或修改 OmniMix 文件。" />
                                                            </StackPanel>
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox
                                                                    x:Name="OmniMixBackendPathBox"
                                                                    Header="OmniMixPlayer.Backend.exe"
                                                                    PlaceholderText="选择 OmniMix 后端程序" />
                                                                <Button
                                                                    Grid.Column="1"
                                                                    Margin="0,24,0,0"
                                                                    Click="BrowseOmniMixBackendButton_Click"
                                                                    Style="{StaticResource PathButtonStyle}"
                                                                    ToolTipService.ToolTip="选择并注册 OmniMix 后端">
                                                                    <SymbolIcon Symbol="OpenFile" />
                                                                </Button>
                                                            </Grid>
                                                            <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        x:Name="OmniMixRegistrationStatusTextBlock"
                                                                        FontWeight="SemiBold"
                                                                        Text="尚未注册 OmniMix 后端" />
                                                                    <TextBlock
                                                                        x:Name="OmniMixClientIdTextBlock"
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="客户端标识将在注册时生成。" />
                                                                </StackPanel>
                                                                <Button
                                                                    x:Name="UnregisterOmniMixButton"
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Click="UnregisterOmniMixButton_Click"
                                                                    Content="解除注册" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Style="{StaticResource SectionStyle}">
                                                        <StackPanel Spacing="12">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock x:Name="MusicScopeSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="替换范围" />
                                                                <TextBlock
                                                                    x:Name="MusicScopeSectionHint"
                                                                    Style="{StaticResource FieldHintStyle}"
                                                                    Text="关闭的场景继续使用游戏原生音乐。" />
                                                            </StackPanel>

                                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    FontWeight="Bold"
                                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                    Text="{Binding Header, ElementName=ReplaceLoginMusicToggle}" />
                                                                <ToggleSwitch
                                                                    x:Name="ReplaceLoginMusicToggle"
                                                                    Grid.Column="1"
                                                                    Header="登录场景"
                                                                    OffContent="原生音乐"
                                                                    OnContent="OmniMix"
                                                                    Style="{StaticResource CompactToggleSwitchStyle}" />
                                                            </Grid>

                                                            <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    FontWeight="Bold"
                                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                    Text="{Binding Header, ElementName=ReplaceMetaMusicToggle}" />
                                                                <ToggleSwitch
                                                                    x:Name="ReplaceMetaMusicToggle"
                                                                    Grid.Column="1"
                                                                    Header="主界面与基地"
                                                                    OffContent="原生音乐"
                                                                    OnContent="OmniMix"
                                                                    Style="{StaticResource CompactToggleSwitchStyle}" />
                                                            </Grid>

                                                            <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    FontWeight="Bold"
                                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                    Text="{Binding Header, ElementName=ReplaceGameplayMusicToggle}" />
                                                                <ToggleSwitch
                                                                    x:Name="ReplaceGameplayMusicToggle"
                                                                    Grid.Column="1"
                                                                    Header="游戏内场景"
                                                                    OffContent="原生音乐"
                                                                    OnContent="OmniMix"
                                                                    Style="{StaticResource CompactToggleSwitchStyle}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Right Column: Buffering & Fallback -->
                                                <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                                                    <Border Style="{StaticResource SectionStyle}">
                                                        <StackPanel Spacing="14">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock x:Name="MusicBufferSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="缓冲与回退" />
                                                                <TextBlock
                                                                    x:Name="MusicBufferSectionHint"
                                                                    Style="{StaticResource FieldHintStyle}"
                                                                    Text="只有 PCM 达到预缓冲且 Wwise 回调正常后，原游戏音乐才会暂停。" />
                                                            </StackPanel>
                                                            <Grid ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <NumberBox
                                                                    x:Name="MusicTargetLatencyNumberBox"
                                                                    FontWeight="Bold"
                                                                    Header="OmniMix 目标延迟 (秒)"
                                                                    Maximum="2"
                                                                    Minimum="0.1"
                                                                    SmallChange="0.05" />
                                                                <NumberBox
                                                                    x:Name="MusicPrebufferNumberBox"
                                                                    Grid.Column="1"
                                                                    FontWeight="Bold"
                                                                    Header="本地预缓冲 (毫秒)"
                                                                    Maximum="1000"
                                                                    Minimum="50"
                                                                    SmallChange="25" />
                                                            </Grid>

                                                            <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        FontSize="14"
                                                                        FontWeight="Bold"
                                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                        Text="{Binding Header, ElementName=FallbackToNativeMusicToggle}" />
                                                                    <TextBlock
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="{Binding OnContent, ElementName=FallbackToNativeMusicToggle}" />
                                                                </StackPanel>
                                                                <ToggleSwitch
                                                                    x:Name="FallbackToNativeMusicToggle"
                                                                    Grid.Column="1"
                                                                    Header="故障时恢复原游戏音乐"
                                                                    OffContent="保持静音"
                                                                    OnContent="自动恢复"
                                                                    Style="{StaticResource CompactToggleSwitchStyle}" />
                                                            </Grid>

                                                            <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock
                                                                        FontSize="14"
                                                                        FontWeight="Bold"
                                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                        Text="{Binding Header, ElementName=MusicDiagnosticsToggle}" />
                                                                    <TextBlock
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="{Binding OnContent, ElementName=MusicDiagnosticsToggle}" />
                                                                </StackPanel>
                                                                <ToggleSwitch
                                                                    x:Name="MusicDiagnosticsToggle"
                                                                    Grid.Column="1"
                                                                    Header="详细诊断日志"
                                                                    OffContent="常规日志"
                                                                    OnContent="记录流状态与缓冲统计"
                                                                    Style="{StaticResource CompactToggleSwitchStyle}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </ContentControl>
                                    </StackPanel>
                                </controls:PageContentPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid
                            x:Name="CombatPageScrollViewer"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Fixed Page Header -->
                            <StackPanel Grid.Row="0" Padding="28,22,28,12" Spacing="4">
                                <TextBlock x:Name="CombatPageTitleTextBlock" Style="{StaticResource PageTitleStyle}" Text="战斗数据" />
                                <TextBlock
                                    x:Name="CombatPageDescriptionTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="记录战斗伤害并按角色、技能和伤害类型汇总。统计默认关闭，不会修改伤害计算。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Row 1: Scrollable Body -->
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <controls:PageContentPanel Padding="28,4,28,28">
                                    <StackPanel Spacing="16">
                                        <!-- Top Master Switch L3 Card -->
                                        <Border Style="{StaticResource SectionStyle}" Padding="22,16">
                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                        Text="{Binding Header, ElementName=CombatStatsToggle}" />
                                                    <TextBlock
                                                        Style="{StaticResource FieldHintStyle}"
                                                        Text="{Binding OnContent, ElementName=CombatStatsToggle}" />
                                                </StackPanel>
                                                <ToggleSwitch
                                                    x:Name="CombatStatsToggle"
                                                    Grid.Column="1"
                                                    Header="启用战斗数据统计"
                                                    OffContent="关闭"
                                                    OnContent="按快捷键记录"
                                                    Style="{StaticResource CompactToggleSwitchStyle}" />
                                            </Grid>
                                        </Border>

                                        <!-- Upper 2-Column Compact Control Area -->
                                        <Grid ColumnSpacing="18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*" />
                                                <ColumnDefinition Width="5*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Card: Display & Hotkeys -->
                                            <Border Grid.Column="0" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                <StackPanel Spacing="12">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock x:Name="CombatDisplaySectionTitle" Style="{StaticResource SectionTitleStyle}" Text="显示与快捷键" />
                                                        <TextBlock
                                                            x:Name="CombatDisplaySectionHint"
                                                            Style="{StaticResource FieldHintStyle}"
                                                            Text="F11 切换开始/停止记录，F12 切换悬浮窗；均可在下方修改。按住 Ctrl 并用鼠标左键拖动悬浮窗可调整位置。"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=HideDamageNumbersToggle}" />
                                                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding OnContent, ElementName=HideDamageNumbersToggle}" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            x:Name="HideDamageNumbersToggle"
                                                            Grid.Column="1"
                                                            Header="隐藏伤害数字"
                                                            OffContent="显示游戏数字"
                                                            OnContent="隐藏数字"
                                                            Style="{StaticResource CompactToggleSwitchStyle}" />
                                                    </Grid>

                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=CombatOverlayToggle}" />
                                                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding OnContent, ElementName=CombatOverlayToggle}" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            x:Name="CombatOverlayToggle"
                                                            Grid.Column="1"
                                                            Header="显示战斗悬浮窗"
                                                            IsOn="True"
                                                            OffContent="不启动悬浮窗"
                                                            OnContent="随模块自动启动"
                                                            Style="{StaticResource CompactToggleSwitchStyle}" />
                                                    </Grid>

                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=CombatOverlayVisibleToggle}" />
                                                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding OnContent, ElementName=CombatOverlayVisibleToggle}" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            x:Name="CombatOverlayVisibleToggle"
                                                            Grid.Column="1"
                                                            Header="悬浮窗初始可见性"
                                                            IsOn="True"
                                                            OffContent="启动后隐藏，按热键显示"
                                                            OnContent="启动后直接显示"
                                                            Style="{StaticResource CompactToggleSwitchStyle}" />
                                                    </Grid>

                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=CombatRdpsDisplayToggle}" />
                                                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="切换 DPS / rDPS 统计口径" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            x:Name="CombatRdpsDisplayToggle"
                                                            Grid.Column="1"
                                                            Header="悬浮窗与本地排行口径"
                                                            OffContent="DPS"
                                                            OnContent="rDPS"
                                                            Style="{StaticResource CompactToggleSwitchStyle}"
                                                            Toggled="CombatRdpsDisplayToggle_Toggled" />
                                                    </Grid>

                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            x:Name="CombatToggleHotkeyBox"
                                                            Header="开始/停止记录快捷键"
                                                            Text="F11" />
                                                        <TextBox
                                                            x:Name="CombatOverlayHotkeyBox"
                                                            Grid.Column="1"
                                                            Header="显示/隐藏悬浮窗快捷键"
                                                            Text="F12" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Right Card: Recording Mode -->
                                            <Border Grid.Column="1" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                <StackPanel Spacing="14">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock x:Name="CombatRecordSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="记录方式" />
                                                        <TextBlock
                                                            x:Name="CombatRecordSectionHint"
                                                            Style="{StaticResource FieldHintStyle}"
                                                            Text="schema 11 仅保存可验证的操作与原子结果；64 位实例 ID 使用字符串保存，无法确定的归属明确标为未知。"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />
                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=AutoDungeonSessionToggle}" />
                                                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding OnContent, ElementName=AutoDungeonSessionToggle}" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            x:Name="AutoDungeonSessionToggle"
                                                            Grid.Column="1"
                                                            Header="自动记录"
                                                            OffContent="手动快捷键"
                                                            OnContent="进关卡自动开启 / 结算自动保存"
                                                            Style="{StaticResource CompactToggleSwitchStyle}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Lower Full-Width Card 1: Combat History -->
                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="14">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock x:Name="CombatHistorySectionTitle" Style="{StaticResource SectionTitleStyle}" Text="历史统计" />
                                                        <TextBlock
                                                            x:Name="CombatHistorySectionHint"
                                                            Style="{StaticResource FieldHintStyle}"
                                                            Text="默认显示最近三条；可按日期和参战角色筛选。"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Top"
                                                        Orientation="Horizontal"
                                                        Spacing="8">
                                                        <Button Click="OpenCombatAnalysisWebButton_Click">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <SymbolIcon Symbol="Globe" />
                                                                <TextBlock x:Name="CombatWebButtonTextBlock" Text="打开解析网页" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Click="OpenCombatRecordsFolderButton_Click">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <SymbolIcon Symbol="Folder" />
                                                                <TextBlock x:Name="CombatRecordsFolderButtonTextBlock" Text="记录文件夹" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button
                                                            x:Name="RefreshCombatSessionsButton"
                                                            Click="RefreshCombatSessionsButton_Click">
                                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                                <SymbolIcon Symbol="Refresh" />
                                                                <TextBlock x:Name="CombatRefreshButtonTextBlock" Text="刷新" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <Border Style="{StaticResource SettingsRowStyle}" Padding="14,12">
                                                    <StackPanel Spacing="10">
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="190" />
                                                                <ColumnDefinition Width="190" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <CalendarDatePicker
                                                                x:Name="CombatFromDatePicker"
                                                                HorizontalAlignment="Stretch"
                                                                DateChanged="CombatDateFilter_DateChanged"
                                                                Header="开始日期"
                                                                PlaceholderText="不限" />
                                                            <CalendarDatePicker
                                                                x:Name="CombatToDatePicker"
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Stretch"
                                                                DateChanged="CombatDateFilter_DateChanged"
                                                                Header="结束日期"
                                                                PlaceholderText="不限" />
                                                            <TextBlock
                                                                x:Name="CombatDateFilterHintTextBlock"
                                                                Grid.Column="2"
                                                                VerticalAlignment="Bottom"
                                                                Margin="4,0,0,8"
                                                                Style="{StaticResource FieldHintStyle}"
                                                                Text="日期范围两端均可留空。" />
                                                        </Grid>
                                                        <StackPanel Spacing="6">
                                                            <TextBlock
                                                                x:Name="CombatTeamFilterHintTextBlock"
                                                                Style="{StaticResource FieldHintStyle}"
                                                                Text="队伍角色（最多四个；记录需包含全部已选角色）" />
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <ComboBox
                                                                    x:Name="CombatCharacterFilter1ComboBox"
                                                                    HorizontalAlignment="Stretch"
                                                                    DisplayMemberPath="DisplayName"
                                                                    PlaceholderText="角色 1"
                                                                    SelectionChanged="CombatCharacterFilterComboBox_SelectionChanged" />
                                                                <ComboBox
                                                                    x:Name="CombatCharacterFilter2ComboBox"
                                                                    Grid.Column="1"
                                                                    HorizontalAlignment="Stretch"
                                                                    DisplayMemberPath="DisplayName"
                                                                    PlaceholderText="角色 2"
                                                                    SelectionChanged="CombatCharacterFilterComboBox_SelectionChanged" />
                                                                <ComboBox
                                                                    x:Name="CombatCharacterFilter3ComboBox"
                                                                    Grid.Column="2"
                                                                    HorizontalAlignment="Stretch"
                                                                    DisplayMemberPath="DisplayName"
                                                                    PlaceholderText="角色 3"
                                                                    SelectionChanged="CombatCharacterFilterComboBox_SelectionChanged" />
                                                                <ComboBox
                                                                    x:Name="CombatCharacterFilter4ComboBox"
                                                                    Grid.Column="3"
                                                                    HorizontalAlignment="Stretch"
                                                                    DisplayMemberPath="DisplayName"
                                                                    PlaceholderText="角色 4"
                                                                    SelectionChanged="CombatCharacterFilterComboBox_SelectionChanged" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <ListView
                                                    x:Name="CombatSessionsListView"
                                                    MaxHeight="520"
                                                    SelectionChanged="CombatSessionsListView_SelectionChanged"
                                                    SelectionMode="Single">
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="4,10" ColumnSpacing="14">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="154" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="142" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DateText}" />
                                                                    <TextBlock
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="{Binding CharacterSummary}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding PreviewCharacters}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border
                                                                                Width="42"
                                                                                Height="42"
                                                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="21">
                                                                                <Image Source="{Binding AvatarSource}" Stretch="UniformToFill" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                                                    <TextBlock
                                                                        HorizontalAlignment="Right"
                                                                        FontSize="18"
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding TotalDamageText}" />
                                                                    <TextBlock
                                                                        HorizontalAlignment="Right"
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="{Binding Summary}" />
                                                                </StackPanel>
                                                                <Button
                                                                    Grid.Column="3"
                                                                    Width="36"
                                                                    Height="36"
                                                                    Padding="8"
                                                                    Click="DeleteCombatSessionButton_Click"
                                                                    Tag="{Binding}"
                                                                    ToolTipService.ToolTip="删除记录">
                                                                    <FontIcon Glyph="&#xE74D;" />
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <Button
                                                    x:Name="ExpandCombatSessionsButton"
                                                    HorizontalAlignment="Center"
                                                    Click="ExpandCombatSessionsButton_Click"
                                                    Visibility="Collapsed" />
                                                <TextBlock
                                                    x:Name="CombatSessionsEmptyTextBlock"
                                                    Style="{StaticResource FieldHintStyle}"
                                                    Text="没有符合筛选条件的战斗统计。"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Lower Full-Width Card 2: Session Breakdown -->
                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock x:Name="CombatSelectedSessionSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="记录明细" />
                                                        <TextBlock
                                                            x:Name="CombatSelectedSessionTextBlock"
                                                            Style="{StaticResource FieldHintStyle}"
                                                            Text="选择一条记录查看。" />
                                                    </StackPanel>
                                                    <Button
                                                        x:Name="AnalyzeCombatSessionButton"
                                                        Grid.Column="1"
                                                        VerticalAlignment="Top"
                                                        Click="AnalyzeCombatSessionButton_Click"
                                                        IsEnabled="False"
                                                        Style="{StaticResource AccentButtonStyle}">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <SymbolIcon Symbol="Globe" />
                                                            <TextBlock x:Name="AnalyzeCombatSessionButtonTextBlock" Text="在网页中解析" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <StackPanel MinHeight="420" Spacing="10">
                                                    <ItemsControl
                                                        x:Name="CombatCategoryLegendItemsControl"
                                                        HorizontalAlignment="Stretch">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <controls:WrapPanel HorizontalSpacing="16" VerticalSpacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Border
                                                                        Width="10"
                                                                        Height="10"
                                                                        Background="{Binding Brush}"
                                                                        CornerRadius="2" />
                                                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding Label}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <ListView
                                                        x:Name="CombatCharacterBreakdownListView"
                                                        MaxHeight="520"
                                                        SelectionMode="None">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Padding="0,9" ColumnSpacing="14">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="54" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="120" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border
                                                                        Width="48"
                                                                        Height="48"
                                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                                        CornerRadius="24">
                                                                        <Image Source="{Binding AvatarSource}" Stretch="UniformToFill" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1" Spacing="5">
                                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                                        <ItemsControl ItemsSource="{Binding Segments}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Orientation="Horizontal" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border
                                                                                        Width="{Binding Width}"
                                                                                        Height="8"
                                                                                        Background="{Binding Brush}"
                                                                                        ToolTipService.ToolTip="{Binding ToolTip}" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding HitSummary}" />
                                                                    </StackPanel>
                                                                    <TextBlock
                                                                        Grid.Column="2"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        FontSize="17"
                                                                        FontWeight="SemiBold"
                                                                        Text="{Binding DamageText}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                                <TextBlock
                                                    x:Name="CombatBreakdownEmptyTextBlock"
                                                    Style="{StaticResource FieldHintStyle}"
                                                    Text="当前记录没有可显示的角色明细。"
                                                    Visibility="Collapsed" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </controls:PageContentPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid
                            x:Name="UiPageScrollViewer"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Fixed Page Header -->
                            <StackPanel Grid.Row="0" Padding="28,22,28,12" Spacing="4">
                                <TextBlock x:Name="UiPageTitleTextBlock" Style="{StaticResource PageTitleStyle}" Text="界面增强" />
                                <TextBlock
                                    x:Name="UiPageDescriptionTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="自定义游戏界面布局、画面遮挡与交互模式。各项默认关闭，切换后会立即保存。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Row 1: Scrollable 2-Column Body -->
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <controls:PageContentPanel Padding="28,4,28,28">
                                    <Grid ColumnSpacing="18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

