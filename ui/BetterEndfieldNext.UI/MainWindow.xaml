                                                        Style="{StaticResource PathButtonStyle}"
                                                        ToolTipService.ToolTip="从列表中移除当前项">
                                                        <SymbolIcon Symbol="Delete" />
                                                    </Button>
                                                </Grid>
                                                <CheckBox
                                                    x:Name="BypassOfficialLauncherCheckBox"
                                                    Content="Steam 原生版 / 直启"
                                                    Click="BypassOfficialLauncherCheckBox_Click" />
                                                <TextBlock
                                                    x:Name="OfficialLauncherPathStatusTextBlock"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="未指定时自动扫描本机官方启动器。" />
