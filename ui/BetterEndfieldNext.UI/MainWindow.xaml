                                                        x:Name="OfficialLauncherComboBox"
                                                        Header="官方启动器"
                                                        HorizontalAlignment="Stretch"
                                                        PlaceholderText="选择或添加官方启动器..."
                                                        SelectionChanged="OfficialLauncherComboBox_SelectionChanged" />
                                                    <Button
                                                        x:Name="BrowseOfficialLauncherButton"
                                                        Grid.Column="1"
                                                        Margin="0,24,0,0"
                                                        Click="BrowseOfficialLauncherButton_Click"
                                                        Style="{StaticResource PathButtonStyle}"
                                                        ToolTipService.ToolTip="浏览并添加官方启动器">
                                                        <SymbolIcon Symbol="OpenFile" />
                                                    </Button>
                                                    <Button
                                                        x:Name="RemoveOfficialLauncherButton"
                                                        Grid.Column="2"
                                                        Margin="0,24,0,0"
