                                                                Width="16"
                                                                Height="16"
                                                                IsActive="False"
                                                                Visibility="Collapsed" />
                                                            <SymbolIcon Symbol="Find" />
                                                            <TextBlock x:Name="ScanPathsButtonTextBlock" FontWeight="Bold" Text="重新扫描" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="88" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        x:Name="GamePathBox"
                                                        Header="游戏程序"
                                                        PlaceholderText="Endfield.exe"
