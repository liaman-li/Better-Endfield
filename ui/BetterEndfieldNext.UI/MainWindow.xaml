                                                        <Button x:Name="MmdSetDefaultButton" Click="MmdSetDefaultButton_Click" Content="设为默认" />
                                                        <Button x:Name="MmdOffsetButton" Click="MmdOffsetButton_Click" Content="音乐偏移" />
                                                        <Button x:Name="MmdDeleteButton" Click="MmdDeleteButton_Click" Content="删除" />
                                                        <Button x:Name="MmdOpenFolderButton" Click="MmdOpenFolderButton_Click" Content="打开文件夹" />
                                                        <Button x:Name="MmdRefreshButton" Click="MmdRefreshButton_Click" Content="刷新" />
                                                    </controls:WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </controls:PageContentPanel>
                            </ScrollViewer>
                        </Grid>

                        <ScrollViewer
                            x:Name="DisplayPageScrollViewer"
                            HorizontalScrollBarVisibility="Disabled"
                            Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto">
                            <controls:PageContentPanel Padding="32,28,32,44">
                            <StackPanel
                                Spacing="28">
                                <StackPanel Spacing="6">
                                    <TextBlock x:Name="DisplayPageTitleTextBlock" Style="{StaticResource PageTitleStyle}" Text="显示增强" />
                                    <TextBlock
                                        x:Name="DisplayPageDescriptionTextBlock"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="通过 OptiScaler 接管客户端的画质提升选项，为 AMD 与 Intel 显卡提供客户端本身不支持的超分方案。"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <InfoBar
                                    x:Name="DisplayWarningInfoBar"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="启用会向 Endfield.exe 所在目录写入 OptiScaler 组件（含 dxgi.dll）与归属记录，不会覆盖未知同名文件。客户端带有内核级反作弊，向游戏目录写入文件比运行时注入更容易被静态扫描发现，是否使用请自行判断。"
                                    Severity="Warning"
                                    Title="会写入游戏目录" />

                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel Spacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="DisplayAdapterSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="显示适配器" />
                                            <TextBlock
                                                x:Name="DisplayGpuTextBlock"
                                                Style="{StaticResource FieldHintStyle}"
                                                Text="正在检测。"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox
                                            x:Name="DisplayBackendComboBox"
                                            Header="超分后端"
                                            HorizontalAlignment="Stretch"
                                            SelectionChanged="DisplayBackendComboBox_SelectionChanged" />
                                        <TextBlock
                                            x:Name="DisplayTradeoffTextBlock"
                                            Style="{StaticResource FieldHintStyle}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                        <ToggleSwitch
                                            x:Name="DisplaySpoofingToggle"
                                            Header="GPU 欺骗"
                                            OffContent="关闭"
                                            OnContent="开启" />
                                        <TextBlock
                                            x:Name="DisplaySpoofingHintTextBlock"
                                            Style="{StaticResource FieldHintStyle}"
                                            Text="客户端的 FSR3 为引擎内置、没有可拦截的 FidelityFX 接口，因此非 NVIDIA 显卡必须开启欺骗让客户端暴露 DLSS 选项，OptiScaler 才能接管。开启后请在客户端【设置-性能与画面-画质提升】中选择 NVIDIA DLSS。"
                                            TextWrapping="Wrap" />
                                        <ToggleSwitch
                                            x:Name="DisplayDiagnosticsToggle"
                                            Header="诊断日志"
                                            OffContent="关闭"
                                            OnContent="写入 OptiScaler 日志到游戏目录" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock x:Name="DisplayDeploySectionTitle" Style="{StaticResource SectionTitleStyle}" Text="组件部署" />
                                        <InfoBar
                                            x:Name="DisplayStatusInfoBar"
                                            IsClosable="False"
                                            IsOpen="True"
                                            Message="正在检查部署状态。"
                                            Severity="Informational"
                                            Title="部署状态" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="InstallDisplayButton"
                                                Click="InstallDisplayButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <SymbolIcon Symbol="Download" />
                                                    <TextBlock x:Name="InstallDisplayButtonTextBlock" Text="部署或更新" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="ApplyDisplayButton"
                                                Click="ApplyDisplayButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <SymbolIcon Symbol="Accept" />
                                                    <TextBlock x:Name="ApplyDisplayButtonTextBlock" Text="应用配置" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="UninstallDisplayButton"
                                                Click="UninstallDisplayButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <SymbolIcon Symbol="Delete" />
                                                    <TextBlock x:Name="UninstallDisplayButtonTextBlock" Text="从游戏目录卸载" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="DisplayNotesTextBlock"
                                            Style="{StaticResource FieldHintStyle}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Name="DisplayUsageSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="使用须知" />
                                        <TextBlock
                                            x:Name="DisplayUsageNotice1TextBlock"
                                            Style="{StaticResource FieldHintStyle}"
                                            Text="OptiScaler 覆盖层由 Insert 键呼出，与战斗数据模块的 F11/F12 不冲突。帧生成不会启用：客户端已有原生 DLSS 帧生成。FSR4 在客户端的 DX11 与 Vulkan 后端下都经 DX12 interop 运行，会额外承担一层同步开销。"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            x:Name="DisplayUsageNotice2TextBlock"
                                            Style="{StaticResource FieldHintStyle}"
                                            Text="OptiScaler 为 GPL-3.0 授权的独立开源项目，不随本软件分发，需自行放入软件目录下的 payloads/optiscaler。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </controls:PageContentPanel>
                        </ScrollViewer>

                        <Grid
                            x:Name="SettingsPageScrollViewer"
                            Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Fixed Page Header -->
                            <StackPanel Grid.Row="0" Padding="28,22,28,12" Spacing="4">
                                <TextBlock x:Name="SettingsPageTitleTextBlock" Style="{StaticResource PageTitleStyle}" Text="设置" />
                                <TextBlock
                                    x:Name="SettingsPageDescriptionTextBlock"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="管理运行路径、加载方式、启动参数、外观和桌面入口。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Row 1: Scrollable Settings Cards -->
                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <controls:PageContentPanel Padding="28,4,28,28">

                                <Grid ColumnSpacing="20" RowSpacing="20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column: Runtime Paths + Desktop Shortcuts -->
                                    <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Top">
                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="14">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
