                                                <TextBlock
                                                    x:Name="InjectorPathStatusTextBlock"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="等待扫描注入器路径。" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource SectionStyle}">
                                            <StackPanel Spacing="12">
                                                <TextBlock x:Name="ShortcutsSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="快捷入口与本地文件" />
