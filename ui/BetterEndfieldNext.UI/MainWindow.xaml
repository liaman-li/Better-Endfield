                                                            x:Name="HideUidSectionHint"
                                                            Style="{StaticResource FieldHintStyle}"
                                                            Text="隐藏游戏画面中的账号 UID 水印。"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />
                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock
                                                                FontSize="14"
                                                                FontWeight="Bold"
                                                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                Text="{Binding Header, ElementName=HideUidToggle}" />
                                                            <TextBlock
                                                                Style="{StaticResource FieldHintStyle}"
                                                                Text="{Binding OnContent, ElementName=HideUidToggle}" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            x:Name="HideUidToggle"
                                                            Grid.Column="1"
                                                            Header="隐藏 UID 水印"
