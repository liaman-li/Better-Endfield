                                                        <TextBox x:Name="MmdKeyframeAddHotkeyBox" Grid.Row="4" Header="记录机位" Text="NUMPAD0" />
                                                        <TextBox x:Name="MmdKeyframePlayHotkeyBox" Grid.Row="4" Grid.Column="1" Header="播放机位" Text="DECIMAL" />
                                                        <TextBox x:Name="MmdKeyframeClearHotkeyBox" Grid.Row="4" Grid.Column="2" Header="清空机位" Text="NONE" />
