                                                                SmallChange="0.5"
                                                                SpinButtonPlacementMode="Compact"
                                                                Value="5"
                                                                ValueChanged="CameraEnhancementNumberBox_ValueChanged" />
                                                            <NumberBox
                                                                x:Name="FreeCameraFieldOfViewNumberBox"
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Header="视野（FOV）"
                                                                Minimum="20"
                                                                Maximum="120"
                                                                SmallChange="1"
                                                                SpinButtonPlacementMode="Compact"
                                                                Value="60"
                                                                ValueChanged="CameraEnhancementNumberBox_ValueChanged" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Right Column: Global FOV + Visual & Occlusion -->
                                                <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Top">
                                                    <Border Style="{StaticResource SectionStyle}">
                                                        <StackPanel Spacing="14">
                                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Header, ElementName=GlobalFovToggle}" />
                                                                    <TextBlock
                                                                        x:Name="GlobalFovHint"
                                                                        Style="{StaticResource FieldHintStyle}"
                                                                        Text="作用于普通主相机。自由视角和导入运镜保留各自的视野；关闭后随游戏下一次相机更新恢复。"
                                                                        TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <ToggleSwitch
                                                                    x:Name="GlobalFovToggle"
                                                                    Grid.Column="1"
                                                                    Header="修改全局视野"
                                                                    OffContent="使用游戏视野"
                                                                    OnContent="覆盖普通主相机视野"
                                                                    Style="{StaticResource CompactToggleSwitchStyle}"
                                                                    Toggled="CameraEnhancementToggle_Toggled" />
                                                            </Grid>
                                                            <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />
                                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    FontWeight="Bold"
                                                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                                    Text="{Binding Header, ElementName=GlobalFieldOfViewNumberBox}" />
                                                                <NumberBox
                                                                    x:Name="GlobalFieldOfViewNumberBox"
                                                                    Grid.Column="1"
                                                                    Width="140"
                                                                    Header="全局视野（FOV）"
                                                                    Minimum="5"
                                                                    Maximum="150"
                                                                    SmallChange="1"
                                                                    SpinButtonPlacementMode="Compact"
                                                                    Value="60"
                                                                    ValueChanged="CameraEnhancementNumberBox_ValueChanged">
                                                                    <NumberBox.HeaderTemplate>
                                                                        <DataTemplate>
                                                                            <Grid Width="0" Height="0" Visibility="Collapsed" />
                                                                        </DataTemplate>
                                                                    </NumberBox.HeaderTemplate>
                                                                </NumberBox>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Style="{StaticResource SectionStyle}">
                                                        <StackPanel Spacing="14">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock x:Name="CameraVisualSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="镜头画面" />
                                                                <TextBlock
                                                                    x:Name="CameraVisualSectionHint"
                                                                    Style="{StaticResource FieldHintStyle}"
                                                                    Text="调用游戏自身的清理逻辑，移除镜头贴近角色时出现的半透明虚化。"
                                                                    TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />
                                                            <Grid ColumnSpacing="12" Padding="0,2">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=DisableDitherToggle}" />
                                                                    <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding OnContent, ElementName=DisableDitherToggle}" />
                                                                </StackPanel>
                                                                <ToggleSwitch
                                                                    x:Name="DisableDitherToggle"
                                                                    Grid.Column="1"
                                                                    Header="移除角色近距离虚化"
                                                                    OffContent="保留原效果"
                                                                    OnContent="关闭虚化"
                                                                    Style="{StaticResource CompactToggleSwitchStyle}"
                                                                    Toggled="CameraEnhancementToggle_Toggled" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Tab 2: 运镜与 VMD -->
                                        <Grid x:Name="CameraTabMotionPanel" ColumnSpacing="18" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="6*" />
                                                <ColumnDefinition Width="5*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Card: Camera Motion Control -->
                                            <Border Grid.Column="0" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                <StackPanel Spacing="14">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock x:Name="CameraMotionSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="运镜与镜头导入" />
                                                        <TextBlock
                                                            x:Name="CameraMotionSectionHint"
                                                            Style="{StaticResource FieldHintStyle}"
                                                            Text="自由视角中可用。小键盘（不需要开启 NumLock）：7/9 滚转，8 复位，1/3 缩放视野，2 开始/停止运镜，0 记录关键帧，. 播放关键帧。滚轮也可缩放视野。清空、保存、读取关键帧在 MMD 悬浮窗里。"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=FreeCameraMouseLookToggle}" />
                                                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding OnContent, ElementName=FreeCameraMouseLookToggle}" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            x:Name="FreeCameraMouseLookToggle"
                                                            Grid.Column="1"
                                                            Header="鼠标转向"
                                                            OffContent="关闭"
                                                            OnContent="自由视角中用鼠标转动镜头"
                                                            IsOn="True"
                                                            Style="{StaticResource CompactToggleSwitchStyle}"
                                                            Toggled="CameraEnhancementToggle_Toggled" />
                                                    </Grid>

                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=FreeCameraInvertYToggle}" />
                                                        <ToggleSwitch
                                                            x:Name="FreeCameraInvertYToggle"
                                                            Grid.Column="1"
                                                            Header="反转鼠标上下"
                                                            OffContent="不反转"
                                                            OnContent="反转"
                                                            Style="{StaticResource CompactToggleSwitchStyle}"
                                                            Toggled="CameraEnhancementToggle_Toggled" />
                                                    </Grid>

                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=KeyframeLoopToggle}" />
                                                            <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding OffContent, ElementName=KeyframeLoopToggle}" />
                                                        </StackPanel>
                                                        <ToggleSwitch
                                                            x:Name="KeyframeLoopToggle"
                                                            Grid.Column="1"
                                                            Header="关键帧循环播放"
                                                            OffContent="播放一次（首尾缓动）"
                                                            OnContent="循环播放"
                                                            Style="{StaticResource CompactToggleSwitchStyle}"
                                                            Toggled="CameraEnhancementToggle_Toggled" />
                                                    </Grid>

                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <NumberBox
                                                            x:Name="FreeCameraMouseSensitivityNumberBox"
                                                            VerticalAlignment="Bottom"
                                                            FontWeight="Bold"
                                                            Header="鼠标灵敏度（度/像素）"
                                                            Minimum="0.01"
                                                            Maximum="2"
                                                            SmallChange="0.01"
                                                            SpinButtonPlacementMode="Compact"
                                                            Value="0.1"
                                                            ValueChanged="CameraEnhancementNumberBox_ValueChanged" />
                                                        <NumberBox
                                                            x:Name="FreeCameraSmoothingNumberBox"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Bottom"
                                                            FontWeight="Bold"
                                                            Header="镜头平滑（%，0 为关闭）"
                                                            Minimum="0"
                                                            Maximum="95"
                                                            SmallChange="5"
                                                            SpinButtonPlacementMode="Compact"
                                                            Value="30"
                                                            ValueChanged="CameraEnhancementNumberBox_ValueChanged" />
                                                        <ComboBox
                                                            x:Name="MotionPresetComboBox"
                                                            Grid.Row="1"
                                                            VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Stretch"
                                                            Header="运镜类型"
                                                            SelectedIndex="0"
                                                            SelectionChanged="MotionPresetComboBox_SelectionChanged">
                                                            <ComboBoxItem Content="环绕角色" />
                                                            <ComboBoxItem Content="推拉变焦（希区柯克）" />
                                                            <ComboBoxItem Content="升降（看向角色）" />
                                                            <ComboBoxItem Content="横向平移" />
                                                        </ComboBox>
                                                        <NumberBox
                                                            x:Name="MotionSpeedNumberBox"
                                                            Grid.Row="1"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Bottom"
                                                            FontWeight="Bold"
                                                            Header="推拉/升降/平移速度（米/秒，可为负）"
                                                            Minimum="-20"
                                                            Maximum="20"
                                                            SmallChange="0.1"
                                                            SpinButtonPlacementMode="Compact"
                                                            Value="1"
                                                            ValueChanged="CameraEnhancementNumberBox_ValueChanged" />
                                                        <NumberBox
                                                            x:Name="OrbitSpeedNumberBox"
                                                            Grid.Row="2"
                                                            VerticalAlignment="Bottom"
                                                            FontWeight="Bold"
                                                            Header="环绕速度（度/秒，负数反向）"
                                                            Minimum="-180"
                                                            Maximum="180"
                                                            SmallChange="5"
                                                            SpinButtonPlacementMode="Compact"
                                                            Value="20"
                                                            ValueChanged="CameraEnhancementNumberBox_ValueChanged" />
                                                        <NumberBox
                                                            x:Name="MotionDurationNumberBox"
                                                            Grid.Row="2"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Bottom"
                                                            FontWeight="Bold"
                                                            Header="运镜时长（秒，0 为不限）"
                                                            Minimum="0"
                                                            Maximum="600"
                                                            SmallChange="1"
                                                            SpinButtonPlacementMode="Compact"
                                                            Value="0"
                                                            ValueChanged="CameraEnhancementNumberBox_ValueChanged" />
                                                        <NumberBox
                                                            x:Name="MotionTargetHeightNumberBox"
                                                            Grid.Row="3"
                                                            VerticalAlignment="Bottom"
                                                            FontWeight="Bold"
                                                            Header="注视点高度（米，相对角色脚底）"
                                                            Minimum="-5"
                                                            Maximum="5"
                                                            SmallChange="0.1"
                                                            SpinButtonPlacementMode="Compact"
                                                            Value="1.2"
                                                            ValueChanged="CameraEnhancementNumberBox_ValueChanged" />
                                                        <NumberBox
                                                            x:Name="KeyframeSegmentNumberBox"
                                                            Grid.Row="3"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Bottom"
                                                            FontWeight="Bold"
                                                            Header="关键帧间隔（秒）"
                                                            Minimum="0.2"
                                                            Maximum="60"
                                                            SmallChange="0.5"
                                                            SpinButtonPlacementMode="Compact"
                                                            Value="3"
                                                            ValueChanged="CameraEnhancementNumberBox_ValueChanged" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Right Card: VMD Camera Import -->
                                            <Border Grid.Column="1" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                <StackPanel Spacing="14">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{Binding Header, ElementName=VmdCameraFileBox}" />
                                                        <TextBlock Style="{StaticResource FieldHintStyle}" Text="加载 .vmd 镜头轨迹并自定义缩放比例与视野修正。" />
                                                    </StackPanel>
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox
                                                            x:Name="VmdCameraFileBox"
                                                            Header="VMD 镜头文件"
                                                            LostFocus="VmdCameraFileBox_LostFocus"
                                                            PlaceholderText="选择 MMD 镜头 .vmd 文件" />
                                                        <Button
                                                            x:Name="VmdCameraBrowseButton"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Bottom"
                                                            Click="VmdCameraBrowseButton_Click"
                                                            Content="浏览" />
                                                    </Grid>
                                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <NumberBox
                                                            x:Name="VmdCameraScaleNumberBox"
                                                            Header="VMD 缩放（米/MMD 单位）"
                                                            Minimum="0.001"
                                                            Maximum="10"
                                                            SmallChange="0.005"
                                                            SpinButtonPlacementMode="Compact"
                                                            Value="0.07"
                                                            ValueChanged="CameraEnhancementNumberBox_ValueChanged" />
                                                        <NumberBox
                                                            x:Name="VmdCameraFovBiasNumberBox"
                                                            Grid.Column="1"
                                                            Header="VMD 视野修正（度）"
                                                            Minimum="-60"
                                                            Maximum="60"
                                                            SmallChange="1"
                                                            SpinButtonPlacementMode="Compact"
                                                            Value="5"
                                                            ValueChanged="CameraEnhancementNumberBox_ValueChanged" />
                                                    </Grid>
                                                    <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />
                                                    <Grid ColumnSpacing="12" Padding="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=VmdCameraLoopToggle}" />
                                                        <ToggleSwitch
                                                            x:Name="VmdCameraLoopToggle"
                                                            Grid.Column="1"
                                                            Header="VMD 镜头循环播放"
                                                            OffContent="播放一次"
                                                            OnContent="循环播放"
                                                            Style="{StaticResource CompactToggleSwitchStyle}"
                                                            Toggled="CameraEnhancementToggle_Toggled" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Tab 3: MMD 播放与作品库 -->
                                        <StackPanel x:Name="CameraTabMmdPanel" Spacing="16" Visibility="Collapsed">
                                            <Grid ColumnSpacing="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6*" />
                                                    <ColumnDefinition Width="5*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Left Card: MMD Playback Control -->
                                                <Border Grid.Column="0" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                    <StackPanel Spacing="14">
                                                        <StackPanel Spacing="3">
                                                            <TextBlock x:Name="MmdSectionTitle" Style="{StaticResource SectionTitleStyle}" Text="MMD 播放与作品库" />
                                                            <TextBlock
                                                                x:Name="MmdSectionHint"
                                                                Style="{StaticResource FieldHintStyle}"
                                                                Text="动作、镜头和音乐共用一个时钟。小键盘：Enter 播放/暂停，+ 停止，4/6 后退/前进，5 切换镜头（VMD/自由/游戏），- 显示/隐藏悬浮窗。VMD 镜头不需要开启自由视角（切到“自由”模式才需要）；音乐通过音乐模块播放（不需要 OmniMix）。"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>

                                                        <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                        <Grid ColumnSpacing="12" Padding="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="{Binding Header, ElementName=MmdEnabledToggle}" />
                                                                <TextBlock Style="{StaticResource FieldHintStyle}" Text="{Binding OnContent, ElementName=MmdEnabledToggle}" />
                                                            </StackPanel>
                                                            <ToggleSwitch
                                                                x:Name="MmdEnabledToggle"
                                                                Grid.Column="1"
                                                                Header="启用 MMD 播放"
                                                                OffContent="关闭"
                                                                OnContent="用小键盘和悬浮窗控制"
                                                                Style="{StaticResource CompactToggleSwitchStyle}"
                                                                Toggled="CameraEnhancementToggle_Toggled" />
                                                        </Grid>

                                                        <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />

                                                        <Grid ColumnSpacing="10" RowSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <Border Style="{StaticResource SettingsRowStyle}" Padding="12,8">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Header, ElementName=MmdBodyToggle}" />
                                                                    <ToggleSwitch x:Name="MmdBodyToggle" Grid.Column="1" Header="身体动作" OffContent="关闭" OnContent="开启" Style="{StaticResource CompactToggleSwitchStyle}" Toggled="CameraEnhancementToggle_Toggled" />
                                                                </Grid>
                                                            </Border>

                                                            <Border Grid.Column="1" Style="{StaticResource SettingsRowStyle}" Padding="12,8">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Header, ElementName=MmdTerrainToggle}" />
                                                                    <ToggleSwitch x:Name="MmdTerrainToggle" Grid.Column="1" Header="地形贴合（实验）" OffContent="关闭" OnContent="开启" Style="{StaticResource CompactToggleSwitchStyle}" Toggled="CameraEnhancementToggle_Toggled" />
                                                                </Grid>
                                                            </Border>

                                                            <Border Grid.Row="1" Style="{StaticResource SettingsRowStyle}" Padding="12,8">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Header, ElementName=MmdFaceToggle}" />
                                                                    <ToggleSwitch x:Name="MmdFaceToggle" Grid.Column="1" Header="表情" OffContent="关闭" OnContent="开启" Style="{StaticResource CompactToggleSwitchStyle}" Toggled="CameraEnhancementToggle_Toggled" />
                                                                </Grid>
                                                            </Border>

                                                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsRowStyle}" Padding="12,8">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Header, ElementName=MmdMusicToggle}" />
                                                                    <ToggleSwitch x:Name="MmdMusicToggle" Grid.Column="1" Header="音乐" OffContent="不播放" OnContent="通过音乐模块播放" IsOn="True" Style="{StaticResource CompactToggleSwitchStyle}" Toggled="CameraEnhancementToggle_Toggled" />
                                                                </Grid>
                                                            </Border>

                                                            <Border Grid.Row="2" Style="{StaticResource SettingsRowStyle}" Padding="12,8">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Header, ElementName=MmdOverlayToggle}" />
                                                                    <ToggleSwitch x:Name="MmdOverlayToggle" Grid.Column="1" Header="悬浮窗" OffContent="关闭" OnContent="小键盘 - 显示/隐藏" IsOn="True" Style="{StaticResource CompactToggleSwitchStyle}" Toggled="CameraEnhancementToggle_Toggled" />
                                                                </Grid>
                                                            </Border>

                                                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingsRowStyle}" Padding="12,8">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Header, ElementName=MmdOverlayVisibleToggle}" />
                                                                    <ToggleSwitch x:Name="MmdOverlayVisibleToggle" Grid.Column="1" Header="进入游戏时显示悬浮窗" OffContent="隐藏" OnContent="显示" Style="{StaticResource CompactToggleSwitchStyle}" Toggled="CameraEnhancementToggle_Toggled" />
                                                                </Grid>
                                                            </Border>

                                                            <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource SettingsRowStyle}" Padding="12,8">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Header, ElementName=MmdLoopToggle}" />
                                                                    <ToggleSwitch x:Name="MmdLoopToggle" Grid.Column="1" Header="循环播放" OffContent="播放一次" OnContent="循环" Style="{StaticResource CompactToggleSwitchStyle}" Toggled="CameraEnhancementToggle_Toggled" />
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Right Card: Cloth Physics & Playback Parameters -->
                                                <Border Grid.Column="1" Style="{StaticResource SectionStyle}" VerticalAlignment="Top">
                                                    <StackPanel Spacing="14">
                                                        <StackPanel Spacing="6">
                                                            <ComboBox
                                                                x:Name="MmdClothComboBox"
                                                                Header="衣物物理"
                                                                HorizontalAlignment="Stretch"
                                                                SelectedIndex="0"
                                                                SelectionChanged="MmdClothComboBox_SelectionChanged">
                                                                <ComboBoxItem Content="稳定（推荐）：完整模拟，不被原动作拉回" />
                                                                <ComboBoxItem Content="游戏原样：不做处理" />
                                                                <ComboBoxItem Content="冻结：关闭模拟，衣物随身体硬动" />
                                                            </ComboBox>
                                                            <TextBlock
                                                                x:Name="MmdClothHint"
                                                                Style="{StaticResource FieldHintStyle}"
                                                                Text="作用于衣服、头发和尾巴的游戏物理，每位跳舞的队员各自处理，停止播放后恢复原设置。在下次开始播放时生效。碰撞体仍是游戏原值，大幅度动作可能穿模。"
                                                                TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Height="1" Background="{ThemeResource SubtleDividerBrush}" />
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
