<UserControl
    x:Class="BetterEndfieldNext.UI.Views.GachaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterEndfieldNext.UI.Controls"
    xmlns:models="using:BetterEndfieldNext.UI.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Fixed Page Header -->
        <Grid Grid.Row="0" Padding="28,22,28,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitleText" Text="寻访查询" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="StatusText" Text="等待连接游戏" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ImportButton" Click="ImportButton_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="OpenFile"/><TextBlock x:Name="ImportButtonText" Text="导入 JSON"/></StackPanel></Button>
                <Button x:Name="ExportButton" Click="ExportButton_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Save"/><TextBlock x:Name="ExportButtonText" Text="导出 JSON"/></StackPanel></Button>
                <Button x:Name="OpenWebButton" Click="OpenWebButton_Click"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Globe"/><TextBlock x:Name="OpenWebButtonText" Text="上传云端"/></StackPanel></Button>
                <Button x:Name="SyncButton" Click="SyncButton_Click" Style="{StaticResource AccentButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Sync"/><TextBlock x:Name="SyncButtonText" Text="同步"/></StackPanel></Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Scrollable Body -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <controls:PageContentPanel Padding="28,4,28,28">
                <StackPanel Spacing="16">
                    <!-- Top Master Switch L3 Card -->
                    <Border Style="{StaticResource SectionStyle}" Padding="22,16">
                        <Grid ColumnSpacing="12" Padding="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Header, ElementName=GachaEnabledToggle}" />
                                <TextBlock
                                    Style="{StaticResource FieldHintStyle}"
                                    Text="{Binding OnContent, ElementName=GachaEnabledToggle}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="GachaEnabledToggle"
                                Grid.Column="1"
                                Header="启用寻访模块"
                                OffContent="关闭：不探测游戏凭据"
                                OnContent="开启：允许从游戏同步记录"
                                Style="{StaticResource CompactToggleSwitchStyle}"
                                Toggled="GachaEnabledToggle_Toggled" />
                        </Grid>
                    </Border>

                    <!-- Summaries Row -->
                    <ItemsControl ItemsSource="{x:Bind Summaries}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:GachaSummaryView"><Border MinWidth="180" Margin="0,0,12,0" Style="{StaticResource SectionStyle}" Padding="18,14"><StackPanel Spacing="6"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind TotalPulls}" FontSize="25" FontWeight="Bold"/><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind SixStarsLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind SixStars}" FontSize="13" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{x:Bind UpOffLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind UpOffText}" FontSize="13" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{x:Bind UpAverageLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind UpAverage}" FontSize="13" FontWeight="SemiBold"/></StackPanel></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

                    <!-- 6 Pool Category Filter Capsule Pills -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left"><Button x:Name="LimitedButton" Content="限定池" Tag="限定" Click="CategoryButton_Click" Style="{StaticResource FilterPillSelectedButtonStyle}"/><Button x:Name="WeaponButton" Content="武器池" Tag="武器" Click="CategoryButton_Click" Style="{StaticResource FilterPillButtonStyle}"/><Button x:Name="FestivalButton" Content="庆典池" Tag="庆典" Click="CategoryButton_Click" Style="{StaticResource FilterPillButtonStyle}"/><Button x:Name="StandardButton" Content="常驻池" Tag="常驻" Click="CategoryButton_Click" Style="{StaticResource FilterPillButtonStyle}"/><Button x:Name="BeginnerButton" Content="新手池" Tag="新手" Click="CategoryButton_Click" Style="{StaticResource FilterPillButtonStyle}"/><Button x:Name="OtherButton" Content="其他" Tag="其他" Click="CategoryButton_Click" Style="{StaticResource FilterPillButtonStyle}"/></StackPanel>

                    <!-- Restrained Centered Empty State Panel (shown only when Pools.Count == 0) -->
                    <Border
                        x:Name="EmptyStatePanel"
                        Style="{StaticResource SectionStyle}"
                        Padding="32,44">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="420">
                            <FontIcon
                                Glyph="&#xE8D4;"
                                FontSize="28"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                x:Name="EmptyStateTitleText"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                HorizontalAlignment="Center"
                                Text="当前卡池暂无寻访记录" />
                            <TextBlock
                                x:Name="EmptyStateHintText"
                                Style="{StaticResource FieldHintStyle}"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                Text="启用寻访模块并在游戏登录后点击右上角「同步」，或直接「导入 JSON」历史记录。" />
                        </StackPanel>
                    </Border>

                    <!-- Pool Statistics Cards -->
                    <ItemsControl ItemsSource="{x:Bind Pools}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:GachaPoolView"><Border Margin="0,0,0,12" Style="{StaticResource SectionStyle}" Padding="20,16"><StackPanel Spacing="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{x:Bind PoolName}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{x:Bind PoolPeriod}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><TextBlock Text="{x:Bind TotalText}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind FreeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Grid>
                        <Grid Visibility="{x:Bind CurrentPityVisibility}" Margin="0,4,0,0" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text=""/><StackPanel Grid.Column="1" Orientation="Horizontal" Width="{x:Bind CurrentPityRow.BarWidth}" Height="18" HorizontalAlignment="Left"><Border Width="{x:Bind CurrentPityRow.CarryBarWidth}" Background="{x:Bind CurrentPityRow.CarryBarBrush}" CornerRadius="2"/><Border Width="{x:Bind CurrentPityRow.PaidBarWidth}" Background="{x:Bind CurrentPityRow.BarBrush}" CornerRadius="2"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind CurrentPityRow.Detail}" HorizontalAlignment="Right"/></Grid>
                        <ItemsControl ItemsSource="{x:Bind SixStars}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:GachaStarView"><Grid Margin="0,4,0,0" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><Image Source="{x:Bind IconSource}" Width="32" Height="32" Stretch="UniformToFill"/><TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Width="{x:Bind BarWidth}" Height="18" HorizontalAlignment="Left"><Border Width="{x:Bind CarryBarWidth}" Background="{x:Bind CarryBarBrush}" CornerRadius="2"/><Border Width="{x:Bind PaidBarWidth}" Background="{x:Bind BarBrush}" CornerRadius="2"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{x:Bind Detail}" HorizontalAlignment="Right"/><Border Background="{x:Bind BadgeBrush}" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right"><TextBlock Text="{x:Bind Badge}" FontSize="11" Foreground="White"/></Border></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <TextBlock Text="{x:Bind FreeSectionTitle}" FontSize="12" Margin="0,6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><ItemsControl ItemsSource="{x:Bind FreeSixStars}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:GachaStarView"><Grid Margin="0,4,0,0" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><Image Source="{x:Bind IconSource}" Width="32" Height="32" Stretch="UniformToFill"/><TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Width="{x:Bind BarWidth}" Height="18" HorizontalAlignment="Left"><Border Width="{x:Bind PaidBarWidth}" Background="{x:Bind BarBrush}" CornerRadius="2"/></StackPanel><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{x:Bind Detail}" HorizontalAlignment="Right"/><Border Background="{x:Bind BadgeBrush}" CornerRadius="3" Padding="6,1" HorizontalAlignment="Right"><TextBlock Text="{x:Bind Badge}" FontSize="11" Foreground="White"/></Border></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
            </controls:PageContentPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
