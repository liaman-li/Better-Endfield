<UserControl
    x:Class="BetterEndfieldNext.UI.Views.WorkshopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BetterEndfieldNext.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Fixed Page Header -->
        <StackPanel Grid.Row="0" Padding="28,22,28,12" Spacing="4">
            <TextBlock
                x:Name="PageTitleText"
                Style="{StaticResource PageTitleStyle}"
                Text="创意工坊" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="通过直连节点或域名镜像访问终末地社区创意工坊。"
                TextWrapping="Wrap" />
        </StackPanel>

        <!-- Row 1: Scrollable 2-Column Cards -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <controls:PageContentPanel Padding="28,4,28,28">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Card: Direct Node -->
                    <Border
                        Grid.Column="0"
                        VerticalAlignment="Top"
                        Style="{StaticResource SectionStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    x:Name="DirectTitleText"
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="直连" />
                                <TextBlock
                                    Style="{StaticResource FieldHintStyle}"
                                    Text="直接连接工坊服务器节点，适合常规网络环境。" />
                            </StackPanel>
                            <TextBox
                                x:Name="DirectUrlBox"
                                FontFamily="Consolas"
                                IsReadOnly="True"
                                Padding="12,8"
                                TextWrapping="NoWrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    x:Name="DirectOpenButton"
                                    Padding="18,7"
                                    Click="DirectOpenButton_Click"
                                    Content="打开"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="DirectCopyButton"
                                    Padding="18,7"
                                    Click="DirectCopyButton_Click"
                                    Content="复制" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Right Card: Domain Node -->
                    <Border
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        Style="{StaticResource SectionStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    x:Name="DomainTitleText"
                                    Style="{StaticResource SectionTitleStyle}"
                                    Text="域名" />
                                <TextBlock
                                    Style="{StaticResource FieldHintStyle}"
                                    Text="通过域名镜像入口访问，适合直连受限的网络环境。" />
                            </StackPanel>
                            <TextBox
                                x:Name="DomainUrlBox"
                                FontFamily="Consolas"
                                IsReadOnly="True"
                                Padding="12,8"
                                TextWrapping="NoWrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button
                                    x:Name="DomainOpenButton"
                                    Padding="18,7"
                                    Click="DomainOpenButton_Click"
                                    Content="打开"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    x:Name="DomainCopyButton"
                                    Padding="18,7"
                                    Click="DomainCopyButton_Click"
                                    Content="复制" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </controls:PageContentPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
